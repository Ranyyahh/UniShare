
@{
    ViewBag.Title = "Messages";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/chatroom.css")" />

<main class="cr-page"
      data-conversations-url="@Url.Action("Conversations", "Messages")"
      data-thread-url="@Url.Action("Thread", "Messages")"
      data-send-url="@Url.Action("Send", "Messages")"
      data-initial-id="@ViewBag.InitialConversationId">

    <!-- Page Heading -->
    <header class="cr-page-heading">
        <div>
            <h1>Messages</h1>
            <p>Ask owners about an item and agree on an on-campus handover spot and time.</p>
        </div>
    </header>

    <section class="cr-shell">

        <!-- LEFT: CONVERSATIONS -->
        <!-- LEFT: CONVERSATIONS -->
        <aside class="cr-inbox">

            <div class="cr-inbox-heading">
                <h2>Conversations</h2>
                <span id="cr-count">0</span>
            </div>

            <!-- Conversation Search -->
            <div class="cr-inbox-search">
                <span class="cr-search-icon">⌕</span>
                <input type="search"
                       id="cr-search"
                       placeholder="Search conversations..."
                       aria-label="Search conversations"
                       autocomplete="off" />
                <button type="button"
                        id="cr-clear-search"
                        title="Clear search"
                        aria-label="Clear search">
                    ×
                </button>
            </div>

            <!-- Conversation List -->
            <div class="cr-list" id="cr-list" aria-live="polite">

                @* Populated from the signed-in user's MongoDB conversations by chatroom.js. *@
                @*<button class="cr-conversation selected"
                        data-id="maya" data-unread="true">

                    <span class="cr-avatar lavender">MD</span>

                    <span class="cr-convo-copy">
                        <b>Mika Dela Rosa</b>
                        <small>Perfect, see you there. I will bring...</small>
                        <small class="cr-item-preview">Casio fx-991EX ClassWiz</small>
                    </span>

                    <span class="cr-meta">
                        <time>2:15 PM</time>
                    </span>
                </button>

                <button class="cr-conversation"
                        data-id="jordan" data-unread="true">

                    <span class="cr-avatar blue">PG</span>

                    <span class="cr-convo-copy">
                        <b>Paolo Garcia</b>
                        <small>Sure, Student Center Lobby again...</small>
                        <small class="cr-item-preview">Staedtler 36-inch T-Square</small>
                    </span>

                    <span class="cr-meta">
                        <time>Yesterday</time>
                    </span>
                </button>

                <button class="cr-conversation"
                        data-id="alex" data-unread="false">

                    <span class="cr-avatar lavender">AR</span>

                    <span class="cr-convo-copy">
                        <b>Ana Reyes</b>
                        <small>Let me check my schedule and...</small>
                        <small class="cr-item-preview">Sony WH-CH520 Wireless Headset</small>
                    </span>

                    <span class="cr-meta">
                        <time>Mon</time>
                    </span>
                </button>

                <button class="cr-conversation"
                        data-id="sam" data-unread="false">

                    <span class="cr-avatar blue">LR</span>

                    <span class="cr-convo-copy">
                        <b>Liza Ramos</b>
                        <small>Thank you, it was a big help for t...</small>
                        <small class="cr-item-preview">Engineering Mechanics (textbook)</small>
                    </span>

                    <span class="cr-meta">
                        <time>Oct 30</time>
                    </span>
                </button>

            </div>*@

            <!-- No Search Results -->
            <div class="cr-no-results" id="cr-no-results" hidden>
                <span>⌕</span>
                <b id="cr-empty-title">No conversations yet</b>
                <small id="cr-empty-copy">Open an item and choose Message Lender to start a conversation.</small>
            </div>

        </aside>



        <!-- CENTER: CHAT WINDOW -->
        <section class="cr-thread">

            <!-- Conversation Header -->
            <header class="cr-thread-head">

                <span class="cr-avatar lavender" id="cr-person-avatar">—</span>

                <div class="cr-person">
                    <b id="cr-person">Choose a conversation</b>
                    <small id="cr-status">Messages about your campus rentals</small>
                </div>

                <span class="cr-request-status"><i></i> UniShare Messages</span>

                <button class="cr-back" id="cr-back">Back</button>

            </header>


            <!-- Chat History -->
            <div class="cr-history" id="cr-history" aria-live="polite">
                @* Messages are rendered from the selected MongoDB thread by chatroom.js. *@
                @*
                <div class="cr-date">
                    <span>Today</span>
                </div>

                <div class="cr-message mine">
                    <div>
                        <p>Hi Mika! Is the calculator free tomorrow from 9 AM to 12 NN?</p>
                        <small><time>1:02 PM</time></small>
                    </div>
                </div>

                <div class="cr-message theirs">
                    <span class="cr-avatar lavender">MD</span>
                    <div>
                        <p>Yes, it is. I can lend it for those hours.</p>
                        <small><time>1:10 PM</time></small>
                    </div>
                </div>

                <div class="cr-message mine">
                    <div>
                        <p>Great. Can we meet at the Main Library Circulation Desk?</p>
                        <small><time>1:12 PM</time></small>
                    </div>
                </div>

                <div class="cr-message theirs">
                    <span class="cr-avatar lavender">MD</span>
                    <div>
                        <p>Works for me. 8:45 AM so you can test it first?</p>
                        <small><time>1:20 PM</time></small>
                    </div>
                </div>

                <div class="cr-message mine">
                    <div>
                        <p>Perfect, see you there. I will bring my QCU ID.</p>
                        <small><time>1:21 PM</time></small>
                    </div>
                </div>

                *@
                <div class="cr-no-results"><b>Select a conversation</b><small>Your messages will appear here.</small></div>
            </div>


            <!-- Suggested Replies -->
            <div class="cr-suggestions">
                <button type="button" data-message="Is it still available?">
                    Is it still available?
                </button>

                <button type="button" data-message="Main Library Circulation Desk?">
                    Main Library Circulation Desk?
                </button>

                <button type="button" data-message="Student Center Lobby?">
                    Student Center Lobby?
                </button>

                <button type="button" data-message="Admin Canteen Security Desk?">
                    Admin Canteen Security Desk?
                </button>
            </div>


            <!-- Message Composer -->
            <form class="cr-composer" id="cr-form">
                @Html.AntiForgeryToken()

                <textarea id="cr-input"
                          rows="1"
                          maxlength="500"
                          placeholder="Select a conversation first..."
                          aria-label="Write a message"></textarea>

                <button type="submit" id="cr-send" disabled>
                    Send
                </button>

            </form>

        </section>


        <!-- RIGHT: ITEM INFORMATION -->
        <aside class="cr-details">

            <!-- Item Card -->
            <div class="cr-item-card">

                <small class="cr-section-label">ITEM</small>

                <div class="cr-photo" id="cr-photo">
                    <span>Item photo</span>
                </div>

                <h3 id="cr-detail-item">Casio fx-991EX ClassWiz</h3>

                <div class="cr-detail-price">
                    <b id="cr-detail-price">₱35</b> / hour
                </div>

                <div class="cr-detail-actions">
                    <a href="#" id="cr-item-link" class="cr-outline-btn" hidden>View item</a>
                    <a href="@Url.Action("Index", "BorrowedItems")" class="cr-outline-btn">View rental</a>
                </div>

            </div>


            <!-- Safe Exchange Reminder -->
            <div class="cr-safety-card">

                <h3>
                    <span class="cr-shield">♧</span>
                    Safe exchange reminder
                </h3>

                <div class="cr-safety-item">
                    <span>✓</span>
                    <p>On-campus handover only</p>
                </div>

                <div class="cr-safety-item">
                    <span>✓</span>
                    <p>Main Library Circulation Desk, Student Center Lobby or Admin Canteen Security Desk</p>
                </div>

                <div class="cr-safety-item">
                    <span>✓</span>
                    <p>Keep arrangements in this chat in case of a dispute</p>
                </div>

            </div>

        </aside>

    </section>

</main>

<div id="cr-toast" role="status" class="cr-toast"></div>

@section scripts {
    <script src="@Url.Content("~/Scripts/chatroom.js")"></script>
}
