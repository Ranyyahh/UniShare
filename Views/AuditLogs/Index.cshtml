@model System.Collections.Generic.IList<UniShare.Models.AuditLogRowViewModel>
@{ ViewBag.Title = "Audit Logs"; ViewBag.ShowAdminSidebar = true; }
@section Styles { <link rel="stylesheet" href="@Url.Content("~/Content/admin-accountability.css")" /> }
<main class="aa-page">
    <header class="aa-page-head"><div><p class="aa-eyebrow">ADMIN ACCOUNTABILITY</p><h1>Audit logs</h1><p>Review important system events and administrator decisions recorded across the platform.</p></div></header>
    @if (ViewBag.DatabaseUnavailable == true) { <div class="aa-alert aa-alert--error">Audit records are unavailable. Check the database connection.</div> }
    <section class="aa-panel">
        <div class="aa-toolbar"><form method="get" action="@Url.Action("Index", "AuditLogs")"><input class="aa-input" type="search" name="search" value="@ViewBag.Search" placeholder="Search actor, action, or record" /><button class="aa-button" type="submit">Search</button><a class="aa-button aa-button--quiet" href="@Url.Action("Index", "AuditLogs")">Reset</a></form></div>
        <div class="aa-table-wrap"><table class="aa-table"><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Record</th><th>Details</th></tr></thead><tbody>
        @if (Model.Count == 0) { <tr><td colspan="5" class="aa-empty">No audit events were found.</td></tr> }
        @foreach (var item in Model) { <tr><td>@item.CreatedAt.ToString("MMM d, yyyy h:mm:ss tt")</td><td>@item.ActorName</td><td><span class="aa-cell-title">@item.Action.Replace('_', ' ')</span></td><td>@item.EntityType<span class="aa-cell-sub">@item.EntityId</span></td><td class="aa-wrap">@item.Summary</td></tr> }
        </tbody></table></div>
    </section>
</main>
