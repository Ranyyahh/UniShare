@model UniShare.Models.VerificationApplicationViewModel
@{ ViewBag.Title = "Student Verification"; Layout = "~/Views/Shared/_AuthLayout.cshtml"; }
<main class="auth-card register-card" aria-labelledby="page-title">
    <div class="portal-badge"><span class="status-dot"></span> STUDENT VERIFICATION</div>
    <h1 id="page-title">Submit your student documents</h1>
    <p class="register-subtitle">Upload a current QCU school ID, 1×1 photo, and registration form (COR). JPG, PNG, or PDF, up to 8 MB each.</p>
    @if (ViewBag.ReviewNotes != null) { <div class="status-panel pending"><strong>Corrections requested</strong><p>@ViewBag.ReviewNotes</p></div> }
    @using (Html.BeginForm("Apply", "Verification", FormMethod.Post, new { enctype = "multipart/form-data", @class = "auth-form register-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "Please correct the following:", new { @class = "text-danger" })
        <div class="field-group"><label for="StudentIdNumber">Student ID number</label><div class="input-wrap">@Html.TextBoxFor(x => x.StudentIdNumber, new { placeholder = "Student ID number" })</div>@Html.ValidationMessageFor(x => x.StudentIdNumber, "", new { @class = "field-error is-visible" })</div>
        <div class="field-row">
            <div class="field-group"><label for="Program">Program</label><div class="input-wrap">@Html.TextBoxFor(x => x.Program, new { placeholder = "e.g. BSIT" })</div>@Html.ValidationMessageFor(x => x.Program, "", new { @class = "field-error is-visible" })</div>
            <div class="field-group"><label for="YearLevel">Year level</label><div class="input-wrap">@Html.DropDownListFor(x => x.YearLevel, new[] { new SelectListItem { Text = "Choose year", Value = "" }, new SelectListItem { Text = "1st year", Value = "1st Year" }, new SelectListItem { Text = "2nd year", Value = "2nd Year" }, new SelectListItem { Text = "3rd year", Value = "3rd Year" }, new SelectListItem { Text = "4th year", Value = "4th Year" }, new SelectListItem { Text = "5th year", Value = "5th Year" } })</div>@Html.ValidationMessageFor(x => x.YearLevel, "", new { @class = "field-error is-visible" })</div>
        </div>
        <div class="verification-field"><label class="verification-label" for="SchoolIdFile">School ID</label>@Html.TextBoxFor(x => x.SchoolIdFile, new { type = "file", accept = ".jpg,.jpeg,.png,.pdf", required = "required" })</div>
        <div class="verification-field"><label class="verification-label" for="OneByOnePhotoFile">1×1 Photo (JPG or PNG)</label>@Html.TextBoxFor(x => x.OneByOnePhotoFile, new { type = "file", accept = ".jpg,.jpeg,.png", required = "required" })</div>
        <div class="verification-field"><label class="verification-label" for="RegistrationFormFile">Current registration form / COR</label>@Html.TextBoxFor(x => x.RegistrationFormFile, new { type = "file", accept = ".jpg,.jpeg,.png,.pdf", required = "required" })</div>
        <button class="primary-button" type="submit">Submit for review</button>
        <div class="form-footer"><a class="text-link" href="@Url.Action("Status")">Back to verification status</a></div>
    }
</main>
