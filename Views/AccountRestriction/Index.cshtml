@model UniShare.Models.AccountRestrictionPageViewModel
@{ ViewBag.Title = "Account Restrictions"; ViewBag.ShowAdminSidebar = true; }
@section Styles { <link rel="stylesheet" href="@Url.Content("~/Content/admin-accountability.css")" /> }
<main class="aa-page">
    <header class="aa-page-head"><div><p class="aa-eyebrow">ADMIN WORKSPACE</p><h1>Account restrictions</h1><p>Record an admin-reviewed warning, temporary suspension, or permanent ban. Actions are written to the audit log.</p></div></header>
    @if (TempData["Success"] != null) { <div class="aa-alert">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="aa-alert aa-alert--error">@TempData["Error"]</div> }
    @if (ViewBag.DatabaseUnavailable == true) { <div class="aa-alert aa-alert--error">Account restrictions are unavailable. Check the database connection.</div> }
    <section class="aa-panel" id="restriction-form"><div class="aa-panel__head"><div><h2>Record an account action</h2><p>Permanent bans and suspensions block the account. Warnings are recorded without blocking access.</p></div></div>
        @using (Html.BeginForm("Create", "AccountRestriction", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="aa-form-grid">
                <label class="aa-field">Student<select class="aa-select" name="userId" required><option value="">Choose a student</option>@foreach (var user in Model.Users) { <option value="@user.Id">@user.Name — @user.StudentNumber (@user.Status)</option> }</select></label>
                <label class="aa-field">Action<select class="aa-select" name="type" required><option value="WARNING">Warning</option><option value="TEMPORARY_SUSPENSION">Temporary suspension</option><option value="PERMANENT_BAN">Permanent ban</option></select></label>
                <label class="aa-field">Suspension length in days <input class="aa-input" type="number" name="days" min="1" max="365" placeholder="Required for temporary suspension" /></label>
                <label class="aa-field aa-field--full">Reason<textarea class="aa-textarea" name="reason" maxlength="1000" required placeholder="Summarize the evidence and the admin decision."></textarea></label>
                <div class="aa-field aa-field--full"><button class="aa-button aa-button--danger" type="submit">Record action</button></div>
            </div>
        }
    </section>
    <section class="aa-panel"><div class="aa-panel__head"><div><h2>Restriction history</h2><p>Warnings, suspensions, bans, and revocations.</p></div></div>
        <div class="aa-table-wrap"><table class="aa-table"><thead><tr><th>Student</th><th>Action</th><th>Reason</th><th>Status</th><th>Recorded by</th><th>Created / ends</th><th></th></tr></thead><tbody>
        @if (Model.Restrictions.Count == 0) { <tr><td colspan="7" class="aa-empty">No account actions have been recorded.</td></tr> }
        @foreach (var item in Model.Restrictions)
        {
            <tr><td>@item.UserName</td><td>@item.Type.Replace('_', ' ')</td><td class="aa-wrap">@item.Reason</td><td><span class="aa-status aa-status--@item.Status.ToLowerInvariant()">@item.Status</span></td><td>@item.CreatedBy</td><td>@item.CreatedAt.ToString("MMM d, yyyy")<span class="aa-cell-sub">@(item.ExpiresAt.HasValue ? "Ends " + item.ExpiresAt.Value.ToString("MMM d, yyyy") : "No expiry")</span></td><td>
                @if (item.CanRevoke) { using (Html.BeginForm("Revoke", "AccountRestriction", FormMethod.Post)) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="aa-button aa-button--quiet" type="submit">Revoke</button> } }
            </td></tr>
        }
        </tbody></table></div>
    </section>
</main>
