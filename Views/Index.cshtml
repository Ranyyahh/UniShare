@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Student Verification";
}

<link rel="stylesheet" href="@Url.Content("~/Content/admin-student-verification.css")" />

<div class="asv-page" data-endpoint="@Url.Action("GetStudents", "AdminStudentVerification")">
    <header class="asv-header">
        <h1 class="asv-header__title">Student Account Verification and Management</h1>
        <p class="asv-header__subtitle">Verify and approve Quezon City University (QCU) student accounts and credentials before granting campus peer rental privileges.</p>
    </header>

    <!-- KPI CARDS -->
    <section class="asv-kpi-grid" aria-label="Verification Metrics">
        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">TOTAL STUDENTS</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--indigo" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-total>0</span></div>
        </article>

        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">PENDING VERIFICATION</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--warning" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" /><path d="M9 12h6M9 16h6" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-pending>0</span></div>
        </article>

        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">APPROVED ACCOUNTS</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--success" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-approved>0</span></div>
        </article>

        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">REJECTED APPLICATIONS</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--error" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-rejected>0</span></div>
        </article>
    </section>

    <!-- TOOLBAR -->
    <section class="asv-toolbar" aria-label="Queue Controls">
        <div class="asv-toolbar__top">
            <div class="asv-search">
                <span class="asv-search__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                </span>
                <input type="text" id="asvSearchInput" class="asv-search__input" placeholder="Search student name, ID, or &#64;qcu.edu.ph email" aria-label="Search student queue" />
            </div>

            <div class="asv-toolbar__actions">
                <div class="asv-select-wrapper">
                    <span class="asv-select-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    </span>
                    <select id="asvStatusSelect" class="asv-select" aria-label="Filter by verification status">
                        <option value="all">All Statuses</option>
                        <option value="pending" selected>Pending Review</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>

                <button type="button" id="btnResetFilters" class="asv-btn-clear" title="Clear All Filters">Clear Filters</button>
            </div>
        </div>
    </section>

    <!-- QUEUE TABLE -->
    <article class="asv-queue-card asv-queue-card--fullwidth">
        <header class="asv-queue-card__header">
            <div>
                <h2 class="asv-queue-card__title">Queue: High Priority First</h2>
                <p class="asv-queue-card__subtitle">Strict 24h Borrowing Active • Click any row to inspect student dossier</p>
            </div>
            <div class="asv-queue-card__selected-count" data-asv-selected-count>Showing 0 Records</div>
        </header>

        <div class="asv-table-wrapper">
            <table class="asv-table" id="asvQueueTable">
                <thead>
                    <tr>
                        <th>STUDENT ID</th>
                        <th>STUDENT &amp; COURSE</th>
                        <th>CAMPUS</th>
                        <th>UNIVERSITY EMAIL</th>
                        <th>DATE REGISTERED</th>
                        <th>STATUS</th>
                        <th class="asv-th--right">ACTION</th>
                    </tr>
                </thead>
                <tbody id="asvTableBody"></tbody>
            </table>
        </div>

        <footer class="asv-queue-card__footer">
            <span class="asv-pagination-info" data-asv-pagination-info>Showing 0 of 0 submissions</span>
            <nav class="asv-pagination" aria-label="Pagination">
                <button type="button" class="asv-pagination__btn asv-pagination__btn--ghost" disabled>Previous</button>
                <button type="button" class="asv-pagination__btn is-active">1</button>
                <button type="button" class="asv-pagination__btn">2</button>
                <button type="button" class="asv-pagination__btn">3</button>
                <button type="button" class="asv-pagination__btn asv-pagination__btn--ghost">Next</button>
            </nav>
        </footer>
    </article>

    <!-- MODAL OVERLAY -->
    <div id="asvModalOverlay" class="asv-modal-overlay" style="display:none;" aria-hidden="true"></div>
    <div id="asvModalContainer" class="asv-modal-container" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="asvDossierTitle">
        <article class="asv-dossier asv-dossier--modal">
            <header class="asv-dossier__header">
                <div class="asv-dossier__title-group">
                    <div class="asv-dossier__header-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="9" cy="10" r="2" /><path d="M15 8h2M15 12h2M7 16h10" /></svg>
                    </div>
                    <div>
                        <span id="asvDossierTitle" class="asv-dossier__label">ACTIVE VERIFICATION DOSSIER</span>
                        <div class="asv-dossier__kyc-id" data-dossier-kyc>#KYC-0000-00000</div>
                    </div>
                </div>
                <div class="asv-dossier__header-right">
                    <span class="asv-pill asv-pill--pending" data-dossier-status-pill>Pending</span>
                    <button type="button" id="btnAsvCloseModal" class="asv-modal-close" title="Close Dossier" aria-label="Close modal">&times;</button>
                </div>
            </header>

            <div class="asv-modal-body-scroll">
                <div class="asv-dossier__identity">
                    <div class="asv-dossier__identity-row">
                        <div class="asv-avatar asv-avatar--lg asv-avatar--indigo" data-dossier-avatar aria-hidden="true">--</div>
                        <div class="asv-dossier__identity-main">
                            <h3 class="asv-dossier__name" data-dossier-name></h3>
                            <p class="asv-dossier__subtitle" data-dossier-course></p>
                            <div class="asv-dossier__badge-row">
                                <span class="asv-chip asv-chip--subtle" data-dossier-id-chip></span>
                                <span class="asv-dossier__campus" data-dossier-campus></span>
                            </div>
                        </div>
                    </div>

                    <div class="asv-dossier__meta-grid">
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">UNIVERSITY EMAIL</span>
                            <div class="asv-meta-item__value"><span data-dossier-email></span></div>
                        </div>
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">CONTACT MOBILE</span>
                            <div class="asv-meta-item__value"><span data-dossier-phone></span></div>
                        </div>
                    </div>
                </div>

                <div class="asv-tabs" role="tablist">
                    <button type="button" class="asv-tab is-active" data-asv-tab="id" role="tab" aria-selected="true">
                        <span class="asv-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="4" width="20" height="16" rx="2" /><circle cx="8" cy="10" r="2" /><path d="M4 17c1.5-2 3.5-2 4-2s2.5 0 4 2" /><line x1="14" y1="9" x2="18" y2="9" /><line x1="14" y1="13" x2="18" y2="13" /></svg></span>
                        <span>1. QCU Student ID</span>
                    </button>
                    <button type="button" class="asv-tab" data-asv-tab="cor" role="tab" aria-selected="false">
                        <span class="asv-tab__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg></span>
                        <span>2. CoR Document</span>
                    </button>
                </div>

                <div class="asv-doc-panel">
                    <div class="asv-tab-panel is-active" data-tab-panel="id">
                        <div class="asv-doc-preview">
                            <div class="asv-doc-preview__header">
                                <div class="asv-doc-preview__logo-group">
                                    <div class="asv-doc-preview__logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg></div>
                                    <div>
                                        <div class="asv-doc-preview__univ">QUEZON CITY UNIVERSITY</div>
                                        <div class="asv-doc-preview__type">OFFICIAL STUDENT ID • SAN BARTOLOME</div>
                                    </div>
                                </div>
                                <span class="asv-doc-preview__sy">S.Y. 2026-2027</span>
                            </div>
                            <div class="asv-doc-preview__body">
                                <div class="asv-doc-preview__photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg></div>
                                <div class="asv-doc-preview__details">
                                    <div class="asv-doc-preview__field">
                                        <span class="asv-doc-preview__field-label">STUDENT NAME</span>
                                        <span class="asv-doc-preview__field-value asv-doc-preview__field-value--name" data-dossier-card-name>--</span>
                                    </div>
                                    <div class="asv-doc-preview__field">
                                        <span class="asv-doc-preview__field-label">COURSE &amp; SECTION</span>
                                        <span class="asv-doc-preview__field-value" data-dossier-card-course>--</span>
                                    </div>
                                    <div class="asv-doc-preview__id-tag" data-dossier-card-id>--</div>
                                </div>
                            </div>
                            <div class="asv-doc-preview__footer">
                                <span class="asv-pill asv-pill--success asv-pill--xs">VALID ENROLLED</span>
                            </div>
                        </div>
                    </div>

                    <div class="asv-tab-panel" data-tab-panel="cor">
                        <div class="asv-cor-preview">
                            <div class="asv-cor-preview__header">
                                <div class="asv-cor-preview__univ">QUEZON CITY UNIVERSITY</div>
                                <div class="asv-cor-preview__doc-title">CERTIFICATE OF REGISTRATION (CoR)</div>
                                <div class="asv-cor-preview__term">Academic Year 2026-2027 • First Semester</div>
                            </div>
                            <div class="asv-cor-preview__info-grid">
                                <div><strong>Student:</strong> <span data-dossier-cor-name>--</span></div>
                                <div><strong>Student Number:</strong> <span data-dossier-cor-id>--</span></div>
                                <div><strong>Degree Program:</strong> BS in Information Technology</div>
                                <div><strong>Units Enrolled:</strong> 21.0 Units</div>
                            </div>
                            <div class="asv-cor-preview__stamp">
                                <span class="asv-pill asv-pill--primary asv-pill--xs">OFFICIALLY ENROLLED</span>
                            </div>
                        </div>
                    </div>

                    <!-- UTILITY CONTROLS -->
                    <div class="asv-doc-meta">
                        <span class="asv-doc-meta__text" data-dossier-meta>--</span>
                        <div class="asv-doc-meta__actions">
                            <button type="button" class="asv-btn-tool" data-asv-util="zoom" title="Zoom Preview" aria-label="Zoom in">
                                <svg class="asv-tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /><line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" /></svg>
                                <span class="asv-tool-text">Zoom</span>
                            </button>
                            <button type="button" class="asv-btn-tool" data-asv-util="rotate" title="Rotate Document" aria-label="Rotate">
                                <svg class="asv-tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                                <span class="asv-tool-text">Rotate</span>
                            </button>
                            <button type="button" class="asv-btn-tool" data-asv-util="download" title="Download Scan" aria-label="Download">
                                <svg class="asv-tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                <span class="asv-tool-text">Save</span>
                            </button>
                            <button type="button" class="asv-btn-tool" data-asv-util="expand" title="Inspect Fullscreen" aria-label="Expand fullscreen">
                                <svg class="asv-tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9" /><polyline points="9 21 3 21 3 15" /><line x1="21" y1="3" x2="14" y2="10" /><line x1="3" y1="21" x2="10" y2="14" /></svg>
                                <span class="asv-tool-text">Expand</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="asv-action-row asv-action-row--modal">
                <button type="button" class="asv-btn asv-btn--primary" data-asv-action="approve">
                    <span class="asv-btn__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12" /></svg></span>
                    <span>Approve Account</span>
                </button>
                <button type="button" class="asv-btn asv-btn--danger" data-asv-action="reject">
                    <span class="asv-btn__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></span>
                    <span>Reject</span>
                </button>
            </footer>
        </article>
    </div>

    <!-- LIGHTBOX -->
    <div id="asvLightbox" class="asv-lightbox-overlay" style="display:none;" aria-hidden="true">
        <div class="asv-lightbox-content" role="dialog" aria-modal="true" aria-label="Full-resolution document view">
            <header class="asv-lightbox-header">
                <div class="asv-lightbox-title-wrap">
                    <span class="asv-pill asv-pill--primary asv-pill--xs">INSPECTION MODE</span>
                    <span class="asv-lightbox-title">High-Resolution Document Preview</span>
                </div>
                <button type="button" id="btnAsvCloseLightbox" class="asv-lightbox-close" title="Close Inspection" aria-label="Close Lightbox">&times;</button>
            </header>
            <div id="asvLightboxBody" class="asv-lightbox-body"></div>
            <footer class="asv-lightbox-footer">
                <small class="asv-lightbox-hint">Press <strong>Esc</strong> or click anywhere outside to close</small>
            </footer>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/admin-student-verification.js")"></script>
}