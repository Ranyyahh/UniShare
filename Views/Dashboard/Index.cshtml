@model UniShare.Models.DashboardViewModel
@{
    ViewBag.Title = "Student Rental Dashboard";

    var anchors = new[]
    {
        new { Icon = "clock",   Title = "Rates from each listing", Text = "Review the hourly or daily rate shown by the owner." },
        new { Icon = "shield",  Title = "Student verification", Text = "Account verification status is shown on each owner profile." },
        new { Icon = "map-pin", Title = "Owner-provided handover", Text = "Check each listing for its campus, building, and handover location." }
    };
}

@* ===== Page-scoped assets (loaded only on this page, so other pages are unaffected) ===== *@
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                colors: {
                    brand: { 50: '#eef2ff', 100: '#e0e7ff', 600: '#2d3282', 700: '#24276b', DEFAULT: '#26297a' },
                    surface: '#f6f7fb'
                }
            }
        }
    };
</script>

<div class="font-sans bg-[#f6f8fc] text-slate-800 antialiased min-h-screen p-4 sm:p-6 md:p-8 lg:p-10 selection:bg-indigo-100 selection:text-indigo-900">
<main class="max-w-[1360px] mx-auto space-y-8">

@* ===== Top header row ===== *@
<section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">

    @* Welcome hero *@
    <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200/80 p-8 sm:p-10 flex flex-col justify-between shadow-[0_2px_8px_-2px_rgba(0,0,0,0.03)]">
        <div class="max-w-2xl">
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">Welcome back, @Model.UserName!</h1>
            <p class="mt-4 text-slate-600 text-base sm:text-lg leading-relaxed">
                Browse student listings, compare rental details, and coordinate handovers using the location and schedule provided by each owner.
            </p>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-3.5">
            <a href="@Url.Action("Index", "BrowseItems")" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-brand text-white font-semibold text-sm hover:bg-opacity-95 transition-all shadow-sm shadow-indigo-900/10 active:scale-[0.98]">
                <i data-lucide="search" class="w-4 h-4 stroke-[2.5]"></i>
                <span>Browse Items</span>
            </a>
            <a href="@Url.Action("Create", "MyListings")" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-all active:scale-[0.98]">
                <i data-lucide="plus-square" class="w-4 h-4 stroke-[2.2] text-slate-600"></i>
                <span>List an Item</span>
            </a>
        </div>
    </div>

    @* Safety anchors *@
    <div class="lg:col-span-4 bg-white rounded-2xl border border-slate-200/80 p-7 flex flex-col justify-between shadow-[0_2px_8px_-2px_rgba(0,0,0,0.03)]">
        <div>
            <div class="flex items-center gap-2.5 text-slate-900 font-bold text-lg">
                <i data-lucide="shield-check" class="w-5 h-5 text-indigo-700 stroke-[2.5]"></i>
                <h2>Guaranteed Safety Anchors</h2>
            </div>
            <p class="mt-1.5 text-xs text-slate-500 leading-normal">
                Check each owner's verification status and review the item's details before arranging a rental.
            </p>
            <div class="mt-4 space-y-2.5">
                @foreach (var a in anchors)
                {
                    <div class="p-3 rounded-xl border border-slate-200/70 bg-slate-50/50 flex items-start gap-3">
                        <div class="p-1 rounded-lg text-indigo-700">
                            <i data-lucide="@a.Icon" class="w-4 h-4 stroke-[2.2]"></i>
                        </div>
                        <div class="text-xs">
                            <h3 class="font-bold text-slate-800">@a.Title</h3>
                            <p class="text-slate-500 text-[11px] mt-0.5">@a.Text</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* ===== Key metrics ===== *@
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    @foreach (var metric in Model.Metrics)
    {
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 flex flex-col justify-between h-44 shadow-[0_2px_6px_-2px_rgba(0,0,0,0.02)]">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-500 tracking-wide">@metric.Title</span>
                    <div class="w-8 h-8 rounded-xl @metric.TintClasses flex items-center justify-center">
                        <i data-lucide="@metric.IconName" class="w-4 h-4 stroke-[2.2]"></i>
                    </div>
                </div>
                <div class="text-3xl font-extrabold text-slate-900 mt-2">@metric.Value</div>
            </div>
            <div>
                @if (!string.IsNullOrEmpty(metric.Footnote))
                {
                    <span class="text-[11px] text-slate-400 font-medium">@metric.Footnote</span>
                }
                else
                {
                    <a href="@metric.LinkUrl" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">@metric.LinkText</a>
                }
            </div>
        </div>
    }
</section>

@* ===== Browse by category ===== *@
<section>
    <h2 class="text-xl font-extrabold text-slate-900 mb-5">Browse by Category</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        @foreach (var category in Model.Categories)
        {
            <a href="@(string.IsNullOrEmpty(category.Url) || category.Url == "#" ? Url.Action("Index", "BrowseItems", new { category = category.Name }) : category.Url)" class="bg-white rounded-2xl border border-slate-200/80 p-5 flex flex-col justify-between h-48 hover:shadow-md hover:border-slate-300 transition">
                <div>
                    <div class="w-10 h-10 rounded-xl @category.TintClasses flex items-center justify-center">
                        <i data-lucide="@category.IconName" class="w-5 h-5 stroke-[2]"></i>
                    </div>
                    <h3 class="font-bold text-slate-900 mt-4 text-base">@category.Name</h3>
                    <p class="text-xs text-slate-500 mt-1 line-clamp-1">@category.Description</p>
                </div>
                <div>
                    <span class="inline-block text-[11px] font-bold text-sky-700 bg-sky-50 px-2.5 py-1 rounded-full border border-sky-100">
                        @category.AvailableCount available
                    </span>
                </div>
            </a>
        }
    </div>
</section>

@* ===== Featured items ===== *@
<section>
    <h2 class="text-xl font-extrabold text-slate-900 mb-5">Featured Items</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        @foreach (var item in Model.FeaturedItems)
        {
            <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden flex flex-col justify-between shadow-[0_2px_6px_-2px_rgba(0,0,0,0.02)]">
                <div>
                    <div class="relative h-48 w-full bg-slate-100 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@Url.Content(item.ImageUrl)" alt="@item.Name" class="w-full h-full object-cover" /> }
                        else { <div class="w-full h-full flex flex-col items-center justify-center bg-slate-100 text-slate-500"><i data-lucide="camera" class="w-6 h-6"></i><span class="text-xs">No photo uploaded</span></div> }
                        <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-[11px] font-bold text-slate-700 px-2.5 py-1 rounded-md shadow-sm">@item.Condition</span>
                        <span class="absolute bottom-3 right-3 bg-brand text-white font-bold text-xs px-2.5 py-1 rounded-md shadow-md">
                            ₱@item.PricePerHour.ToString("0.##") <span class="font-normal text-[10px] opacity-90">/ hr</span>
                        </span>
                    </div>
                    <div class="p-5 pb-2">
                        <h3 class="font-bold text-slate-900 text-sm tracking-tight truncate" title="@item.Name">@item.Name</h3>
                        <div class="mt-2 flex items-center gap-2 text-xs text-slate-600 font-medium">
                            <div class="w-4 h-4 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center">
                                <i data-lucide="user" class="w-3 h-3"></i>
                            </div>
                            <span>@item.OwnerName • @item.OwnerCourse</span>
                        </div>
                    </div>
                </div>
                <div class="p-5 pt-3">
                    <a href="@Url.Action("ItemDetails", "BrowseItems", new { id = item.Id })"
                       class="w-full py-2.5 px-4 rounded-xl bg-indigo-50/80 text-brand font-bold text-xs hover:bg-indigo-100 transition flex items-center justify-center gap-1">
                        <span>View Details</span>
                        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                    </a>
                </div>
            </article>
        }
    </div>
</section>

@* ===== Recently listed items ===== *@
<section>
    <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-extrabold text-slate-900">Recently Listed Items</h2>
        <a href="@Url.Action("Index", "BrowseItems")" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
            <span>View All Items</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (var item in Model.RecentItems)
        {
            <div class="bg-white rounded-2xl border border-slate-200/80 p-4 flex flex-col justify-between shadow-[0_2px_6px_-2px_rgba(0,0,0,0.02)]">
                <div class="flex items-start gap-3.5">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@Url.Content(item.ImageUrl)" alt="@item.Name" class="w-12 h-12 rounded-xl object-cover shrink-0 bg-slate-100" /> }
                    else { <div class="w-12 h-12 rounded-xl shrink-0 bg-slate-100 flex items-center justify-center text-slate-500"><i data-lucide="camera" class="w-4 h-4"></i></div> }
                    <div class="min-w-0">
                        <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded @item.ConditionBadgeClasses">@item.Condition</span>
                        <h3 class="text-xs font-bold text-slate-900 truncate mt-1">@item.Name</h3>
                        <p class="text-[11px] text-slate-500 truncate">@item.Subtitle</p>
                    </div>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                    <span class="font-extrabold text-brand shrink-0">₱@item.PricePerHour.ToString("0.##") <span class="font-normal text-[10px] text-slate-500">/ hr</span></span>
                    <a class="text-xs font-bold text-brand hover:underline" href="@Url.Action("ItemDetails", "BrowseItems", new { id = item.Id })">View Details</a>
                </div>
            </div>
        }
    </div>
</section>

</main>
</div>

<script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
<script>lucide.createIcons();</script>
