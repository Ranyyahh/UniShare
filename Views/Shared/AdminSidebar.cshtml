@{
    string currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
}
<aside class="sidebar" role="navigation">
    <div class="sidebar-top">
        <!-- Brand / Header -->
        <div class="sidebar-brand">
            <div class="sidebar-logo-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                    <polyline points="16 6 12 2 8 6"></polyline>
                    <line x1="12" y1="2" x2="12" y2="15"></line>
                </svg>
            </div>
            <div class="sidebar-brand-text">
                <span class="sidebar-brand-title">UniShare</span>
                <span class="sidebar-brand-badge">ADMIN PORTAL</span>
            </div>
        </div>

        <!-- Navigation Links -->
        <nav class="sidebar-menu">
            <!-- 1. Admin Dashboard -->
            <a href="@Url.Action("Index", "Home")" class="sidebar-link @(currentController.Equals("Home", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <span class="sidebar-link-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                </span>
                <span class="sidebar-link-label">Admin Dashboard</span>
            </a>

            <!-- 2. Dispute Management -->
            <a href="@Url.Action("DisputeManagement", "DisputeManagement")" class="sidebar-link @(currentController.Equals("DisputeManagement", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <span class="sidebar-link-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </span>
                <span class="sidebar-link-label">Dispute Management</span>
            </a>

            <!-- 3. Student Verification -->
            <a href="#" class="sidebar-link @(currentController.Equals("StudentVerification", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <span class="sidebar-link-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <polyline points="17 11 19 13 23 9"></polyline>
                    </svg>
                </span>
                <span class="sidebar-link-label">Student Verification</span>
            </a>

            <!-- 4. Item & Booking Monitoring -->
            <a href="#" class="sidebar-link @(currentController.Equals("ItemBookingMonitoring", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <span class="sidebar-link-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </span>
                <span class="sidebar-link-label">Item & Booking Monitoring</span>
            </a>

            <!-- 5. Transactions & Payments -->
            <a href="@Url.Action("TransactionPaymentRecords", "TransactionPaymentRecords")" class="sidebar-link @(currentController.Equals("TransactionPaymentRecords", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <span class="sidebar-link-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                        <line x1="2" y1="10" x2="22" y2="10"></line>
                        <line x1="6" y1="15" x2="10" y2="15"></line>
                    </svg>
                </span>
                <span class="sidebar-link-label">Transactions & Payments</span>
            </a>

            <!-- 6. Reports & Analytics -->
            <a href="@Url.Action("Index", "ReportsAnalytics")" class="sidebar-link @(currentController.Equals("ReportsAnalytics", System.StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <span class="sidebar-link-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                </span>
                <span class="sidebar-link-label">Reports & Analytics</span>
            </a>
        </nav>
    </div>

    <!-- Sidebar Bottom: Log Out -->
    <div class="sidebar-bottom">
        <a href="#" class="sidebar-link sidebar-logout" title="Log Out of Admin Portal">
            <span class="sidebar-link-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </span>
            <span class="sidebar-link-label">Log Out</span>
        </a>
    </div>
</aside>
