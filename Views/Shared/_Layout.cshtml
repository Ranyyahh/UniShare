<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - UniShare</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @Html.Partial("_Header")
    <main class="site-main" id="main-content">
        @RenderBody()
    </main>
    @Html.Partial("_Footer")

    @* Messages + Notifications pop-up windows (opened from the navbar icons) *@
    @Html.Partial("_HeaderModals")

    @Scripts.Render("~/bundles/jquery")
    @{ string popupsUrl = Url.Content("~/Scripts/unishare-popups.js") + "?v=" + System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/unishare-popups.js")).Ticks; }
    <script src="@popupsUrl"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
