<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - UniShare</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" href="@Url.Action("Index", "Home")" aria-label="UniShare home">
                <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 7h11l-3-3m3 3-3 3M17 17H6l3 3m-3-3 3-3" /></svg></span>
                <span class="brand__copy"><span class="brand__name">UniShare</span><span class="brand__school">Quezon City University</span></span>
            </a>
            <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
            <nav class="site-navigation" id="site-navigation" aria-label="Main navigation">
                <div class="site-navigation__links">
                    @Html.ActionLink("Dashboard", "Index", "Dashboard", null, new { @class = "site-navigation__link" })
                    @Html.ActionLink("Browse Items", "Index", "BrowseItems", null, new { @class = "site-navigation__link" })
                    @Html.ActionLink("My Listings", "Index", "MyListings", null, new { @class = "site-navigation__link" })

                    @Html.ActionLink("My Rentals", "Index", "MyRentals", null, new { @class = "site-navigation__link" })

                    @Html.ActionLink("Borrowed Items", "Index", "BorrowedItems", null, new { @class = "site-navigation__link" })

                    @Html.ActionLink("Reports & Analytics", "Index", "ReportsAnalytics", null, new { @class = "site-navigation__link" })

@if (User != null && User.IsInRole("ADMIN"))
{
    <a class="site-navigation__link" href="@Url.Action("StudentVerification", "Admin")">Admin Verification</a>
}
                </div>
                <div class="site-navigation__actions">
                    <a class="icon-button message-button" href="@Url.Action("Index", "Messages")" aria-label="Messages"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5 8 8 0 0 1-3.8-.95L4 20l1.2-3.9A7.5 7.5 0 1 1 20 11.5Z" /><path d="M8 11.5h8M8 14.5h5" /></svg></a>
                    <button class="icon-button notification-button" type="button" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><span class="notification-dot"></span></button>
                    @if (Request.IsAuthenticated)
                    {
                        <div class="account-menu" data-account-menu>
                            <button class="account-button" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="account-dropdown" data-account-toggle>
                                <span class="account-avatar" aria-hidden="true" data-account-avatar>?</span>
                                <span class="account-copy"><span class="account-copy__top" data-account-name>Account</span><span class="account-copy__bottom" data-account-subtitle>Student</span></span>
                                <svg class="account-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
                            </button>
                            <div class="account-dropdown" id="account-dropdown" role="menu" hidden>
                                <button class="account-dropdown__item" type="button" role="menuitem" data-account-open>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-3.3 3.1-5 7-5s6.5 1.7 7 5"/></svg>My Account
                                </button>
                                <a class="account-dropdown__item" role="menuitem" href="@Url.Action("Status", "Verification")">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 6.5v2L12 13l9-4.5v-2L12 2Zm-7 9v5l7 3.5 7-3.5v-5l-7 3.5L5 11Z"/></svg>Verification Status
                                </a>
                                @if (User != null && User.IsInRole("ADMIN"))
                                {
                                    <a class="account-dropdown__item" role="menuitem" href="@Url.Action("StudentVerification", "Admin")">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Admin Verification
                                    </a>
                                }
                                <a class="account-dropdown__item" role="menuitem" href="@Url.Action("Settings", "Account")">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1a1.7 1.7 0 1 1-2.4 2.4l-.1-.1a1.7 1.7 0 0 0-2.9 1.2v.2a1.7 1.7 0 1 1-3.4 0v-.2a1.7 1.7 0 0 0-2.9-1.2l-.1.1a1.7 1.7 0 1 1-2.4-2.4l.1-.1a1.7 1.7 0 0 0-1.2-2.9H4a1.7 1.7 0 1 1 0-3.4h.2a1.7 1.7 0 0 0 1.2-2.9l-.1-.1a1.7 1.7 0 1 1 2.4-2.4l.1.1a1.7 1.7 0 0 0 2.9-1.2V2a1.7 1.7 0 1 1 3.4 0v.2a1.7 1.7 0 0 0 2.9 1.2l.1-.1a1.7 1.7 0 1 1 2.4 2.4l-.1.1a1.7 1.7 0 0 0 1.2 2.9h.2a1.7 1.7 0 1 1 0 3.4h-.2a1.7 1.7 0 0 0-1.2 2.9Z"/></svg>Account Settings
                                </a>
                                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "account-logout-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="account-dropdown__item account-dropdown__item--danger" type="submit" role="menuitem">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3"/><path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg>Logout
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex; align-items:center; gap: 8px;">
                            <a class="site-navigation__link" href="@Url.Action("Login", "Account")" style="font-weight:600;">Sign in</a>
                            <a class="primary-button" href="@Url.Action("Register", "Account")" style="padding: 6px 14px; font-size: 0.875rem; text-decoration:none;">Register</a>
                        </div>
                    }
                </div>
            </nav>
        </div>
    </header>
    <script>
        (function () {
            var toggle = document.querySelector('.site-menu-toggle');
            var navigation = document.getElementById('site-navigation');
            if (!toggle || !navigation) return;
            toggle.addEventListener('click', function () {
                var expanded = toggle.getAttribute('aria-expanded') === 'true';
                toggle.setAttribute('aria-expanded', String(!expanded));
                navigation.classList.toggle('is-open', !expanded);
            });
        }());
    </script>
    <main class="site-main" id="main-content">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="site-footer__inner">
            <a class="site-footer__brand" href="@Url.Action("Index", "Home")">UniShare</a>
            <p class="site-footer__copyright">&copy; @DateTime.Now.Year UniShare &bull; Quezon City University Campus Marketplace. All rights reserved.</p>
        </div>
    </footer>

    <div class="account-modal" data-account-modal data-profile-url="@Url.Action("Profile", "Account")" aria-hidden="true" hidden>
        <div class="account-modal__backdrop" data-account-close></div>
        <section class="account-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="account-modal-title" tabindex="-1" data-account-dialog>
            <header class="account-modal__header">
                <div><span class="account-modal__eyebrow">PROFILE</span><h2 id="account-modal-title">My Account</h2></div>
                <button class="account-modal__close" type="button" aria-label="Close My Account" data-account-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
            </header>
            <div class="account-modal__body" data-account-profile aria-live="polite">
                <div class="account-profile-loading"><span class="account-avatar account-avatar--large" aria-hidden="true">?</span><span>Loading profile…</span></div>
            </div>
        </section>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="@Url.Content("~/Scripts/account-menu.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
