@using System.Linq
@using UniShare.Models
@{
    // Pop-up windows opened by the Messages and Notifications icons in the navbar.
    // Data goes to the browser as JSON; Scripts/unishare-popups.js renders and runs them.
    var payload = new
    {
        conversations = SampleData.Conversations.Select(c => new
        {
            id = c.Id,
            person = c.With,
            initials = c.Initials,
            item = c.ItemName,
            last = c.LastMessage,
            time = c.Time,
            unread = c.Unread,
            messages = c.Messages.Select(m => new { mine = m.Mine, text = m.Text, time = m.Time }).ToList()
        }).ToList(),
        notifications = SampleData.Notifications.Select(n => new
        {
            id = n.Id,
            title = n.Title,
            body = n.Body,
            time = n.Time,
            unread = n.Unread
        }).ToList()
    };
    string popupJson = System.Web.Helpers.Json.Encode(payload).Replace("<", "\\u003c");
}

<dialog class="bi-dialog pm-dialog pm-dialog--sm" id="pm-notes" aria-labelledby="pm-notes-title">
    <header class="bi-dialog__head">
        <h2 id="pm-notes-title">Notifications <span id="pm-notes-count" class="pm-count" hidden>0 new</span></h2>
        <div class="pm-head-actions">
            <button type="button" id="pm-notes-readall" class="us-btn us-btn--sm">Mark all as read</button>
        </div>
        <button type="button" class="bi-x" data-pm-close aria-label="Close">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
    </header>
    <ul class="us-list pm-notes" id="pm-notes-list"></ul>
</dialog>

<dialog class="bi-dialog pm-dialog pm-dialog--wide" id="pm-msgs" aria-labelledby="pm-msgs-title">
    <header class="bi-dialog__head">
        <h2 id="pm-msgs-title">Messages</h2>
        <button type="button" class="bi-x" data-pm-close aria-label="Close">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
    </header>
    <div class="us-chat" id="pm-chat">
        <aside class="us-chat__list" id="pm-chat-list"></aside>
        <section class="us-chat__panel" id="pm-chat-panel"></section>
    </div>
</dialog>

<script type="application/json" id="pm-data">@Html.Raw(popupJson)</script>
