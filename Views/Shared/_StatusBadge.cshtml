@model string
@{
    var cls = "us-badge--gray";
    switch (Model)
    {
        case "Available": case "Approved": case "Paid": case "Completed": cls = "us-badge--green"; break;
        case "Ongoing": cls = "us-badge--blue"; break;
        case "Pending": case "Rented": cls = "us-badge--amber"; break;
        case "Disputed": cls = "us-badge--red"; break;
    }
}
<span class="us-badge @cls">@Model</span>
