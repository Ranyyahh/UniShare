@{
    ViewBag.Title = "Reports & Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/ReportsAnalytics.css" />

<div class="reports-page" id="reportsPage" 
     data-data-url="@Url.Action("Data", "ReportsAnalytics")" 
     data-export-url="@Url.Action("Export", "ReportsAnalytics")"
     data-default-from="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")"
     data-default-to="@DateTime.Today.ToString("yyyy-MM-dd")">

    <!-- A. Page Header -->
    <header class="reports-header">
        <div class="reports-header__title-group">
            <h1 class="reports-header__title">Reports &amp; Analytics</h1>
            <p class="reports-header__description">A summary of platform revenue, rentals, and user activity.</p>
        </div>
    </header>

    <div class="reports-notice" id="reportsNotice" role="status"></div>

    <!-- B. Date Filters -->
    <form class="reports-filters" id="reportsFilterForm" novalidate>
        <div class="reports-filters__fields">
            <div class="reports-field">
                <label for="filterFrom" class="reports-field__label">From</label>
                <input type="date" id="filterFrom" class="reports-input" />
            </div>
            <div class="reports-field">
                <label for="filterTo" class="reports-field__label">To</label>
                <input type="date" id="filterTo" class="reports-input" />
            </div>
            <div class="reports-filters__buttons">
                <button type="submit" id="btnApplyFilter" class="reports-btn reports-btn--primary">Apply</button>
                <button type="button" id="btnResetFilter" class="reports-btn reports-btn--secondary">Reset</button>
            </div>
        </div>
        <p class="reports-period" id="reportsPeriod"></p>
        <p class="reports-filters__error" id="filterError" hidden></p>
    </form>

    <!-- C. Overview Cards -->
    <section class="reports-summary">
        <div class="reports-card">
            <div class="reports-card__content"><span class="reports-card__label">Total Revenue</span><span class="reports-card__value" id="cardRevenue">₱0.00</span></div>
        </div>
        <div class="reports-card">
            <div class="reports-card__content"><span class="reports-card__label">Total Rentals</span><span class="reports-card__value" id="cardRentals">0</span></div>
        </div>
        <div class="reports-card">
            <div class="reports-card__content"><span class="reports-card__label">Items Rented</span><span class="reports-card__value" id="cardItems">0</span></div>
        </div>
        <div class="reports-card">
            <div class="reports-card__content"><span class="reports-card__label">Total Borrowings</span><span class="reports-card__value" id="cardBorrowings">0</span></div>
        </div>
    </section>

    <!-- D. Charts -->
    <section class="reports-section">
        <article class="reports-panel reports-panel--featured">
            <header class="reports-panel__header">
                <h3 class="reports-panel__title">Rental Revenue Over Time</h3>
                <div class="reports-panel__stats" id="statsRevenue"></div>
            </header>
            <div class="reports-chart reports-chart--tall" id="chartRevenue"></div>
        </article>

        <div class="reports-grid-2">
            <article class="reports-panel">
                <header class="reports-panel__header"><h3 class="reports-panel__title">Most Rented Items</h3></header>
                <div class="reports-chart" id="chartTopItems"></div>
            </article>
            <article class="reports-panel">
                <header class="reports-panel__header"><h3 class="reports-panel__title">Rental Status Distribution</h3></header>
                <div class="reports-chart" id="chartStatus"></div>
            </article>
        </div>
    </section>

    <section class="reports-section">
        <div class="reports-grid-2">
            <article class="reports-panel">
                <header class="reports-panel__header"><h3 class="reports-panel__title">Borrowing Activity</h3></header>
                <div class="reports-chart" id="chartActivity"></div>
            </article>
            <article class="reports-panel">
                <header class="reports-panel__header"><h3 class="reports-panel__title">Borrowing Expenses</h3></header>
                <div class="reports-chart" id="chartExpenses"></div>
            </article>
        </div>
    </section>

    <div class="reports-tooltip" id="reportsTooltip" role="tooltip" hidden></div>
</div>

@section scripts {
    <script src="~/Scripts/ReportsAnalytics.js"></script>
}
