@model UniShare.Models.ReportsAnalyticsViewModel
@{
    ViewBag.Title = "Reports & Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string noticeClass = string.IsNullOrWhiteSpace(Model.DataSourceNote) ? "reports-notice" : "reports-notice is-visible";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/ReportsAnalytics.css")" />
}

<div class="reports-page"
     id="reportsPage"
     data-data-url="@Model.DataUrl"
     data-export-url="@Model.ExportUrl"
     data-default-from="@Model.DefaultFrom"
     data-default-to="@Model.DefaultTo">

    <!-- A. Page Header -->
    <header class="reports-header">
        <div class="reports-header__title-group">
            <h1 class="reports-header__title">Reports &amp; Analytics</h1>
            <p class="reports-header__description">Your lending income and borrowing activity from your own rental transactions.</p>
        </div>
        <div class="reports-header__actions">
            <button type="button" id="btnExportReport" class="reports-btn reports-btn--secondary" title="Download this report as a CSV file">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Export</span>
            </button>
        </div>
    </header>

    <!-- Status banner: data-source limitation, sign-in and load errors -->
    <div class="@noticeClass" id="reportsNotice" role="status" aria-live="polite">@Model.DataSourceNote</div>

    <!-- B. Date Filters -->
    <form class="reports-filters" id="reportsFilterForm" novalidate>
        <div class="reports-filters__fields">
            <div class="reports-field">
                <label for="filterFrom" class="reports-field__label">From</label>
                <input type="date" id="filterFrom" class="reports-input" value="@Model.DefaultFrom" />
            </div>
            <div class="reports-field">
                <label for="filterTo" class="reports-field__label">To</label>
                <input type="date" id="filterTo" class="reports-input" value="@Model.DefaultTo" />
            </div>
            <div class="reports-filters__buttons">
                <button type="submit" id="btnApplyFilter" class="reports-btn reports-btn--primary">Apply</button>
                <button type="button" id="btnResetFilter" class="reports-btn reports-btn--secondary">Reset</button>
            </div>
        </div>
        <div class="reports-quick" role="group" aria-label="Quick date ranges">
            <button type="button" class="reports-chip" data-range="week">This Week</button>
            <button type="button" class="reports-chip" data-range="lastweek">Last Week</button>
            <button type="button" class="reports-chip" data-range="month">This Month</button>
        </div>
        <p class="reports-period" id="reportsPeriod" aria-live="polite"></p>
        <p class="reports-filters__error" id="filterError" role="alert" hidden></p>
    </form>

    <!-- C. Overview Cards -->
    <section class="reports-summary" aria-label="Overview">
        <div class="reports-card reports-card--revenue">
            <div class="reports-card__content">
                <span class="reports-card__label">Total Revenue</span>
                <span class="reports-card__value" id="cardRevenue">&#8369;0.00</span>
                <span class="reports-card__hint">Completed rentals of your items</span>
            </div>
            <div class="reports-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 21V4h5.5a4.25 4.25 0 0 1 0 8.5H8M5 8h12M5 12h12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
        <div class="reports-card reports-card--rentals">
            <div class="reports-card__content">
                <span class="reports-card__label">Total Rentals</span>
                <span class="reports-card__value" id="cardRentals">0</span>
                <span class="reports-card__hint">Transactions on your items</span>
            </div>
            <div class="reports-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
        <div class="reports-card reports-card--items">
            <div class="reports-card__content">
                <span class="reports-card__label">Items Rented</span>
                <span class="reports-card__value" id="cardItems">0</span>
                <span class="reports-card__hint">Total quantity rented out</span>
            </div>
            <div class="reports-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8zM3.3 7.5 12 12.5l8.7-5M12 22V12.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
        <div class="reports-card reports-card--borrowings">
            <div class="reports-card__content">
                <span class="reports-card__label">Total Borrowings</span>
                <span class="reports-card__value" id="cardBorrowings">0</span>
                <span class="reports-card__hint">Items you borrowed</span>
            </div>
            <div class="reports-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 7h11l-3-3m3 3-3 3M17 17H6l3 3m-3-3 3-3" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
    </section>

    <!-- D. Renting charts -->
    <section class="reports-section" aria-labelledby="rentingHeading">
        <h2 class="reports-section__title" id="rentingHeading">Rentals</h2>

        <article class="reports-panel reports-panel--featured">
            <header class="reports-panel__header">
                <div>
                    <h3 class="reports-panel__title">Rental Revenue Over Time</h3>
                    <p class="reports-panel__subtitle" id="revenueSubtitle">Completed rentals only</p>
                </div>
                <div class="reports-panel__stats" id="statsRevenue"></div>
            </header>
            <div class="reports-chart reports-chart--tall" id="chartRevenue"></div>
        </article>

        <div class="reports-grid-2">
            <article class="reports-panel">
                <header class="reports-panel__header">
                    <div>
                        <h3 class="reports-panel__title">Most Rented Items</h3>
                        <p class="reports-panel__subtitle">Quantity rented, top 10</p>
                    </div>
                </header>
                <div class="reports-chart" id="chartTopItems"></div>
            </article>
            <article class="reports-panel">
                <header class="reports-panel__header">
                    <div>
                        <h3 class="reports-panel__title">Rental Status Distribution</h3>
                        <p class="reports-panel__subtitle">Your rental transactions by status</p>
                    </div>
                </header>
                <div class="reports-chart" id="chartStatus"></div>
                <p class="reports-panel__footnote" id="statusFootnote"></p>
            </article>
        </div>
    </section>

    <!-- E. Borrowing charts -->
    <section class="reports-section" aria-labelledby="borrowingHeading">
        <h2 class="reports-section__title" id="borrowingHeading">Borrowing <span>items you rent from others</span></h2>
        <div class="reports-grid-2">
            <article class="reports-panel">
                <header class="reports-panel__header">
                    <div>
                        <h3 class="reports-panel__title">Borrowing Activity</h3>
                        <p class="reports-panel__subtitle" id="activitySubtitle">Borrowing transactions over time</p>
                    </div>
                    <div class="reports-panel__stats" id="statsActivity"></div>
                </header>
                <div class="reports-chart" id="chartActivity"></div>
            </article>
            <article class="reports-panel">
                <header class="reports-panel__header">
                    <div>
                        <h3 class="reports-panel__title">Borrowing Expenses</h3>
                        <p class="reports-panel__subtitle">Owner-confirmed Cash payments only</p>
                    </div>
                    <div class="reports-panel__stats" id="statsExpenses"></div>
                </header>
                <div class="reports-chart" id="chartExpenses"></div>
                <p class="reports-panel__footnote" id="expensesFootnote"></p>
            </article>
        </div>
    </section>

    <section class="reports-section" aria-labelledby="requestActivityHeading">
        <h2 class="reports-section__title" id="requestActivityHeading">Rental Request Activity <span>received vs submitted</span></h2>
        <div class="reports-grid-2">
            <article class="reports-panel">
                <header class="reports-panel__header"><div><h3 class="reports-panel__title">Requests Received</h3><p class="reports-panel__subtitle">For items you own</p></div></header>
                <div class="reports-chart" id="chartRequestsReceived"></div>
            </article>
            <article class="reports-panel">
                <header class="reports-panel__header"><div><h3 class="reports-panel__title">Requests Submitted</h3><p class="reports-panel__subtitle">For items you borrowed</p></div></header>
                <div class="reports-chart" id="chartRequestsSubmitted"></div>
            </article>
        </div>
    </section>

    <section class="reports-section" aria-labelledby="transactionsHeading">
        <h2 class="reports-section__title" id="transactionsHeading">Transaction History</h2>
        <article class="reports-panel reports-history-panel">
            <div class="reports-table-wrap">
                <table class="reports-table">
                    <thead><tr><th>Item</th><th>Role</th><th>Date</th><th>Amount</th><th>Mode of Payment</th><th>Status</th><th>Transaction</th></tr></thead>
                    <tbody id="reportsTransactions"><tr><td colspan="7" class="reports-table__empty">Loading your transactions…</td></tr></tbody>
                </table>
            </div>
        </article>
        <p class="reports-data-note">Payments are Cash only. Borrowing expenses include rental payments confirmed by the item owner; refunded payments are excluded. UniShare does not record sales transactions.</p>
    </section>

    <div class="reports-tooltip" id="reportsTooltip" role="tooltip" hidden></div>
</div>

@section scripts {
    <script src="~/Scripts/ReportsAnalytics.js"></script>
}
