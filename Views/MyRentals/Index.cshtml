                                <span class="borrower-avatar" id="detailsBorrowerInitials" aria-hidden="true"></span>
                                <div class="borrower-meta">
                                    <span class="borrower-name" id="detailsBorrowerName"></span>
                                    <span class="borrower-program" id="detailsBorrowerProgram"></span>
                                </div>
                            </div>
                        </dd>
                    </div>
                    <div class="my-rentals-details-field">
                        <dt>Request Date</dt>
                        <dd><span class="details-primary" id="detailsRequestDate"></span></dd>
                    </div>
                    <div class="my-rentals-details-field">
                        <dt>Handover Schedule</dt>
                        <dd><span class="details-primary" id="detailsHandover"></span></dd>
                    </div>
                    <div class="my-rentals-details-field">
                        <dt>Duration</dt>
                        <dd><span class="details-primary" id="detailsDuration"></span></dd>
                    </div>
                    <div class="my-rentals-details-field">
                        <dt>Rental Fee</dt>
                        <dd><span class="details-primary details-fee" id="detailsFee"></span></dd>
                    </div>
                    <div class="my-rentals-details-field my-rentals-details-field--full"><dt>Request note</dt><dd><span class="details-primary" id="detailsRequestNote"></span></dd></div>
                    <div class="my-rentals-details-field my-rentals-details-field--full"><dt>Handover confirmation</dt><dd class="details-confirmations"><span id="detailsOwnerConfirmation"></span><span id="detailsBorrowerConfirmation"></span></dd></div>
                    <div class="my-rentals-details-field my-rentals-details-field--full" id="detailsTimerField" hidden><dt>Rental timer</dt><dd><span class="details-primary" id="detailsTimer"></span></dd></div>
                </dl>
            </div>

            <footer class="my-rentals-modal__footer">
                <button type="button"
                        class="my-rentals-btn my-rentals-btn-secondary"
                        id="btnDetailsClose">
                    Close
                </button>
            </footer>
        </div>
    </div>
</div>

<!-- Raw JSON Model for Client-Side Filtering -->
<script id="myRentalsRawData" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Rentals))
</script>

@section scripts {
    <script src="~/Scripts/MyRentals.js"></script>
}
