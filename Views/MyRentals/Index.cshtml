@model UniShare.Models.MyRentalsViewModel
@{
    ViewBag.Title = "Rentals";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/MyRentals.css" />

<div class="my-rentals-page" data-history-url="@Url.Action("HistoryData", "MyRentals")" data-handover-url="@Url.Action("ConfirmHandover", "MyRentals")" data-return-url="@Url.Action("ConfirmReturn", "MyRentals")">
    @Html.AntiForgeryToken()
    <!-- A. Page Header -->
    <header class="my-rentals-header">
        <div class="my-rentals-header__title-group">
            <h1 class="my-rentals-header__title">Rentals</h1>
            <p class="my-rentals-header__description">Manage rental requests, monitor active and overdue bookings, and keep track of returns and reported issues.</p>
        </div>
        <div class="my-rentals-header__actions">
        <button type="button" id="btnRentalHistory" class="my-rentals-btn-history" aria-haspopup="dialog" aria-controls="myRentalsHistoryModal">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8M8 9h2"/><circle cx="18" cy="17" r="4" fill="white"/><path d="M18 15v2l1.5 1"/></svg>
            <span>History</span>
        </button>
        <button type="button"
                id="btnRefreshRentals"
                class="my-rentals-btn-refresh"
                title="Refresh rentals"
                aria-label="Refresh rentals and reset the page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /><polyline points="21 3 21 9 15 9" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>Refresh</span>
        </button>
        </div>
    </header>

    <div id="myRentalsHistoryModal" class="my-rentals-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="myRentalsHistoryTitle">
        <section class="my-rentals-modal my-rentals-modal--history">
            <header class="my-rentals-modal__header"><div><h2 class="my-rentals-modal__title" id="myRentalsHistoryTitle">Rental History</h2><p class="my-rentals-modal__description">Past rentals you requested and rentals received for your listings.</p></div><button type="button" class="my-rentals-modal__close-btn" id="btnCloseRentalHistory" aria-label="Close history">&times;</button></header>
            <div class="my-rentals-modal__body"><div id="myRentalsHistoryContent" class="my-rentals-history-content" aria-live="polite">Loading history…</div></div>
            <footer class="my-rentals-modal__footer"><button type="button" class="my-rentals-btn my-rentals-btn-secondary" id="btnRentalHistoryDone">Close</button></footer>
        </section>
    </div>

    <!-- B. Summary Cards (display-only; filtering is done through the Filter modal) -->
    <section class="my-rentals-summary" aria-label="Rentals Summary">
        <div class="my-rentals-card my-rentals-card--total">
            <div class="my-rentals-card__content">
                <span class="my-rentals-card__label">Total Rentals</span>
                <div class="my-rentals-card__metric">
                    <span class="my-rentals-card__value" data-summary-value="total">@Model.Summary.TotalRentals</span>
                    <span class="my-rentals-card__hint">All records</span>
                </div>
            </div>
            <div class="my-rentals-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
        <div class="my-rentals-card my-rentals-card--pending">
            <div class="my-rentals-card__content">
                <span class="my-rentals-card__label">Pending Requests</span>
                <div class="my-rentals-card__metric">
                    <span class="my-rentals-card__value" data-summary-value="pending">@Model.Summary.PendingRequests</span>
                    <span class="my-rentals-card__hint">Awaiting your action</span>
                </div>
            </div>
            <div class="my-rentals-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
        <div class="my-rentals-card my-rentals-card--active">
            <div class="my-rentals-card__content">
                <span class="my-rentals-card__label">Active Rentals</span>
                <div class="my-rentals-card__metric">
                    <span class="my-rentals-card__value" data-summary-value="active">@Model.Summary.ActiveRentals</span>
                    <span class="my-rentals-card__hint">On loan</span>
                </div>
            </div>
            <div class="my-rentals-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
        <div class="my-rentals-card my-rentals-card--attention">
            <div class="my-rentals-card__content">
                <span class="my-rentals-card__label">Need Attention</span>
                <div class="my-rentals-card__metric">
                    <span class="my-rentals-card__value" data-summary-value="attention">@Model.Summary.NeedAttention</span>
                    <span class="my-rentals-card__hint" id="summaryAttentionBreakdown">Overdue: @Model.Summary.OverdueCount &middot; Disputed: @Model.Summary.DisputedCount</span>
                </div>
            </div>
            <div class="my-rentals-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
    </section>

    <!-- C. Search and Filter Controls -->
    <section class="my-rentals-controls" aria-label="Rental Search and Filters">
        <div class="my-rentals-controls__search-wrapper">
            <span class="my-rentals-controls__search-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.8" fill="none" /><line x1="12.5" y1="12.5" x2="17.5" y2="17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </span>
            <input type="text"
                   id="myRentalsSearchInput"
                   class="my-rentals-search-input"
                   placeholder="Search rentals..."
                   aria-label="Search rentals by request ID, item, borrower, duration, or fee" />
            <button type="button"
                    id="myRentalsSearchClear"
                    class="my-rentals-search-clear"
                    title="Clear search"
                    aria-label="Clear search input"
                    style="display: none;">
                &times;
            </button>
        </div>

        <div class="my-rentals-controls__actions">
            <!-- Filter Button triggering Filter Modal -->
            <button type="button"
                    id="btnOpenFilterModal"
                    class="my-rentals-btn-filter"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="myRentalsFilterModal">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 4.5h15M5.5 10h9M8.5 15.5h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
                <span>Filter</span>
                <span id="activeFilterBadge" class="my-rentals-filter-badge" title="Number of statuses selected" style="display: none;">0</span>
            </button>

            <!-- Booking Date Dropdown -->
            <div class="my-rentals-date-select-wrapper">
                <label for="myRentalsDateFilter" class="sr-only">Booking Date</label>
                <select id="myRentalsDateFilter" class="my-rentals-date-select" aria-label="Filter rentals by booking date">
                    <option value="All Time" selected>All Time</option>
                    <option value="Today">Today</option>
                    <option value="Last 7 Days">Last 7 Days</option>
                    <option value="Last 30 Days">Last 30 Days</option>
                    <option value="This Month">This Month</option>
                </select>
                <svg class="my-rentals-select-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
        </div>
    </section>

    <!-- D. Rentals Table Section -->
    <section class="my-rentals-table-section" aria-label="Rentals Table">
        <div class="my-rentals-table-responsive">
            <table class="my-rentals-table" id="myRentalsTable">
                <thead>
                    <tr>
                        <th scope="col" class="th-request-id">Request ID</th>
                        <th scope="col" class="th-item">Item</th>
                        <th scope="col" class="th-borrower">Borrower</th>
                        <th scope="col" class="th-request-date">Request Date</th>
                        <th scope="col" class="th-schedule">Handover Schedule</th>
                        <th scope="col" class="th-duration">Duration</th>
                        <th scope="col" class="th-fee">Rental Fee</th>
                        <th scope="col" class="th-status">Status</th>
                        <th scope="col" class="th-action text-right">Action</th>
                    </tr>
                </thead>
                <tbody id="myRentalsTableBody">
                    @foreach (var item in Model.Rentals)
                    {
                        var statusClass = "status-" + item.Status.ToLowerInvariant();
                        <tr class="my-rentals-row"
                            data-request-id="@item.RequestId"
                            data-item="@item.ItemName"
                            data-borrower="@item.BorrowerName"
                            data-status="@item.Status"
                            data-date="@item.HandoverDate.ToString("yyyy-MM-dd")"
                            data-request-date="@item.RequestDate.ToString("yyyy-MM-dd")"
                            data-fee="@item.RentalFee"
                            data-duration="@item.Duration">
                            <td class="td-request-id">
                                <span class="request-id-badge">@item.RequestId</span>
                            </td>
                            <td class="td-item">
                                <div class="item-cell">
                                    <span class="item-name">@item.ItemName</span>
                                    <span class="item-category">@item.Category</span>
                                </div>
                            </td>
                            <td class="td-borrower">
                                <div class="borrower-cell">
                                    <div class="borrower-meta">
                                        <span class="borrower-name">@item.BorrowerName</span>
                                        <span class="borrower-program">@item.BorrowerProgram</span>
                                    </div>
                                </div>
                            </td>
                            <td class="td-request-date">
                                <span class="request-date-text">@item.RequestDateFormatted</span>
                            </td>
                            <td class="td-schedule">
                                <span class="schedule-text">@item.HandoverScheduleFormatted</span>
                            </td>
                            <td class="td-duration">
                                <span class="duration-text">@item.Duration</span>
                            </td>
                            <td class="td-fee">
                                <span class="fee-text">@item.RentalFeeFormatted</span>
                            </td>
                            <td class="td-status">
                                <span class="status-badge @statusClass">
                                    <span class="status-dot" aria-hidden="true"></span>
                                    <span class="status-label">@item.Status</span>
                                </span>
                            </td>
                            <td class="td-action text-right">
                                <button type="button"
                                        class="my-rentals-btn-view"
                                        data-request-id="@item.RequestId"
                                        aria-label="View details for @item.RequestId">
                                    View Details
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Empty State Display -->
            <div id="myRentalsEmptyState" class="my-rentals-empty-state" style="display: none;">
                <div class="my-rentals-empty-state__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8" fill="none" /><line x1="12" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="12" cy="16" r="1" fill="currentColor" /></svg>
                </div>
                <h3 class="my-rentals-empty-state__title" id="emptyStateTitle">No rentals found</h3>
                <p class="my-rentals-empty-state__text" id="emptyStateText">No rentals matched your active filters. Try adjusting your search query, status selection, or date range.</p>
                <div class="my-rentals-empty-state__actions">
                    <button type="button" id="btnEmptyResetFilters" class="my-rentals-btn my-rentals-btn-secondary">Reset Status Filters</button>
                    <button type="button" id="btnEmptyClearAll" class="my-rentals-btn my-rentals-btn-primary">Clear All Filters</button>
                </div>
            </div>
        </div>

        <!-- E. Pagination Controls -->
        <footer class="my-rentals-pagination" id="myRentalsPagination" aria-label="Table pagination">
            <div class="my-rentals-pagination__info" id="paginationInfo">
                Showing <strong id="paginationStart">1</strong> &ndash; <strong id="paginationEnd">6</strong> of <strong id="paginationTotal">@Model.Rentals.Count</strong> rentals
            </div>
            <div class="my-rentals-pagination__controls">
                <button type="button"
                        id="btnPaginationPrev"
                        class="my-rentals-pagination__btn"
                        aria-label="Previous page">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m10 12-4-4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
                    <span>Previous</span>
                </button>
                <span class="my-rentals-pagination__page-label" id="paginationPageLabel">Page 1 of 3</span>
                <button type="button"
                        id="btnPaginationNext"
                        class="my-rentals-pagination__btn"
                        aria-label="Next page">
                    <span>Next</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
                </button>
            </div>
        </footer>
    </section>

    <!-- 5. FUNCTIONAL FILTER MODAL -->
    <div id="myRentalsFilterModal"
         class="my-rentals-modal-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="modalFilterTitle"
         aria-describedby="modalFilterDesc">
        <div class="my-rentals-modal">
            <!-- Modal Header -->
            <header class="my-rentals-modal__header">
                <div class="my-rentals-modal__header-copy">
                    <h2 class="my-rentals-modal__title" id="modalFilterTitle">Filter Rentals</h2>
                    <p class="my-rentals-modal__description" id="modalFilterDesc">All statuses are shown by default. Untick the statuses you want to hide, then click Apply Filters.</p>
                </div>
                <button type="button"
                        class="my-rentals-modal__close-btn"
                        id="btnCloseFilterModal"
                        aria-label="Close filter modal">
                    &times;
                </button>
            </header>

            <!-- Modal Body: Status Checkboxes -->
            <div class="my-rentals-modal__body">
                <div class="my-rentals-modal__status-header">
                    <span class="my-rentals-modal__section-label">Rental Status</span>
                    <span id="statusSelectedCount" class="my-rentals-modal__count-pill">All statuses</span>
                </div>

                <label class="my-rentals-checkbox-label my-rentals-select-all">
                    <input type="checkbox"
                           class="my-rentals-checkbox"
                           id="chkSelectAllStatuses" />
                    <span class="checkbox-custom" aria-hidden="true"></span>
                    <span class="checkbox-text-group">
                        <span class="checkbox-name">Select All</span>
                    </span>
                </label>

                <div class="my-rentals-modal__checkbox-list" role="group" aria-label="Status selection">
                    <!-- Option 1: Pending -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Pending"
                               data-status="Pending"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Pending</span>
                            <span class="status-badge status-pending sm"><span class="status-dot"></span>Pending</span>
                        </span>
                    </label>

                    <!-- Option 2: Accepted -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Accepted"
                               data-status="Accepted"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Accepted</span>
                            <span class="status-badge status-accepted sm"><span class="status-dot"></span>Accepted</span>
                        </span>
                    </label>

                    <!-- Option 3: Declined -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Declined"
                               data-status="Declined"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Declined</span>
                            <span class="status-badge status-declined sm"><span class="status-dot"></span>Declined</span>
                        </span>
                    </label>

                    <!-- Option 4: Ongoing -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Ongoing"
                               data-status="Ongoing"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Ongoing</span>
                            <span class="status-badge status-ongoing sm"><span class="status-dot"></span>Ongoing</span>
                        </span>
                    </label>

                    <!-- Option 5: Overdue -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Overdue"
                               data-status="Overdue"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Overdue</span>
                            <span class="status-badge status-overdue sm"><span class="status-dot"></span>Overdue</span>
                        </span>
                    </label>

                    <!-- Option 6: Returned -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Returned"
                               data-status="Returned"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Returned</span>
                            <span class="status-badge status-returned sm"><span class="status-dot"></span>Returned</span>
                        </span>
                    </label>

                    <!-- Option 7: Disputed -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Disputed"
                               data-status="Disputed"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Disputed</span>
                            <span class="status-badge status-disputed sm"><span class="status-dot"></span>Disputed</span>
                        </span>
                    </label>

                    <!-- Option 8: Completed -->
                    <label class="my-rentals-checkbox-label">
                        <input type="checkbox"
                               class="my-rentals-checkbox status-filter-checkbox"
                               value="Completed"
                               data-status="Completed"
                               checked />
                        <span class="checkbox-custom" aria-hidden="true"></span>
                        <span class="checkbox-text-group">
                            <span class="checkbox-name">Completed</span>
                            <span class="status-badge status-completed sm"><span class="status-dot"></span>Completed</span>
                        </span>
                    </label>
                </div>
            </div>

            <!-- Modal Footer -->
            <footer class="my-rentals-modal__footer">
                <button type="button"
                        class="my-rentals-btn my-rentals-btn-secondary"
                        id="btnFilterReset">
                    Reset
                </button>
                <button type="button"
                        class="my-rentals-btn my-rentals-btn-primary"
                        id="btnFilterApply">
                    Apply Filters
                </button>
            </footer>
        </div>
    </div>

    <!-- MODAL A: Pending Details (View Details on a Pending row) -->
    <div id="modalPendingDetails"
         class="my-rentals-modal-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="pendingDetailsTitle">
        <div class="my-rentals-modal my-rentals-modal--lg">
            <header class="my-rentals-modal__header">
                <div class="my-rentals-modal__header-copy">
                    <h2 class="my-rentals-modal__title" id="pendingDetailsTitle">Rental Request Details <span class="rm-request-id" id="pendingRequestId"></span></h2>
                    <p class="my-rentals-modal__description">Review the rental info before accepting or declining.</p>
                </div>
                <button type="button" class="my-rentals-modal__close-btn" id="btnClosePendingDetails" aria-label="Close">&times;</button>
            </header>
            <div class="my-rentals-modal__body">
                <!-- Item card -->
                <div class="rm-item-card">
                    <div class="rm-item-thumb" id="pendingItemThumb" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.5" fill="none" /><path d="M3 9h18M9 21V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                    </div>
                    <div class="rm-item-info">
                        <span class="rm-item-category" id="pendingItemCategory"></span>
                        <span class="rm-item-name" id="pendingItemName"></span>
                        <span class="rm-item-location" id="pendingItemLocation"></span>
                    </div>
                    <div class="rm-item-rate">
                        <span class="rm-fee-value" id="pendingFeeValue"></span>
                        <span class="rm-fee-label">est. fee</span>
                    </div>
                </div>
                <!-- Borrower row -->
                <div class="rm-borrower-row">
                    <span class="rm-borrower-avatar" id="pendingBorrowerInitials"></span>
                    <div class="rm-borrower-info">
                        <span class="rm-borrower-name" id="pendingBorrowerName"></span>
                        <span class="rm-borrower-program" id="pendingBorrowerProgram"></span>
                    </div>
                    <span class="rm-verified-badge">&#10003; Verified</span>
                </div>
                <!-- Rental detail rows -->
                <div class="rm-section-label">REQUESTED RENTAL DETAILS</div>
                <div class="rm-detail-grid">
                    <div class="rm-detail-item">
                        <svg class="rm-detail-icon" viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.5" fill="none" /><path d="M3 8h14M7 2v4M13 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                        <div>
                            <span class="rm-detail-label">Handover Date</span>
                            <span class="rm-detail-value" id="pendingHandoverDate"></span>
                        </div>
                    </div>
                    <div class="rm-detail-item">
                        <svg class="rm-detail-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5" fill="none" /><path d="M10 6v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                        <div>
                            <span class="rm-detail-label">Handover Time</span>
                            <span class="rm-detail-value" id="pendingHandoverTime"></span>
                        </div>
                    </div>
                    <div class="rm-detail-item">
                        <svg class="rm-detail-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M10 4v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                        <div>
