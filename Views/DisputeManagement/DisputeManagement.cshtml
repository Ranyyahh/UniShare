@model List<UniShare.Models.DisputeViewModel>
@{
    ViewBag.Title = "Dispute Management";
    ViewBag.ShowAdminSidebar = true;
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/DisputeManagement.css")" />
}

<div class="dispute-page-wrapper">
    <!-- Header Block (Clean Title & Subtitle Only) -->
    <div class="dispute-header-block">
        <h1 class="page-title">Dispute Management</h1>
        <p class="page-subtitle">Review reported rental issues, inspect mutual evidence, and adjudicate fair resolutions between student lenders and borrowers across QCU campuses.</p>
    </div>

    <!-- 4 Compact Stat Cards (Total, Open, Under Review, Resolved) -->
    <div class="row stats-row">
        <div class="col-xs-6 col-sm-3 col-md-3">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Total Disputes</span>
                    <span class="stat-icon stat-icon-purple"><i class="glyphicon glyphicon-scale"></i></span>
                </div>
                <div class="stat-value">@(ViewBag.TotalDisputes ?? 28)</div>
                <div class="stat-desc">Monitored campus incidents</div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-3 col-md-3">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Open Disputes</span>
                    <span class="stat-icon stat-icon-rose"><i class="glyphicon glyphicon-alert"></i></span>
                </div>
                <div class="stat-value">@(ViewBag.OpenDisputes ?? 7)</div>
                <div class="stat-desc stat-alert-text">Requires Triage</div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-3 col-md-3">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Under Review</span>
                    <span class="stat-icon stat-icon-indigo"><i class="glyphicon glyphicon-search"></i></span>
                </div>
                <div class="stat-value">@(ViewBag.UnderReview ?? 12)</div>
                <div class="stat-desc">In Mediation</div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-3 col-md-3">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Resolved Disputes</span>
                    <span class="stat-icon stat-icon-emerald"><i class="glyphicon glyphicon-ok-circle"></i></span>
                </div>
                <div class="stat-value">@(ViewBag.ResolvedDisputes ?? 89)</div>
                <div class="stat-desc">Mutual Accord</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar Directly Above Full-Width Table -->
    <div class="filter-bar">
        <div class="search-input-group">
            <span class="search-icon"><i class="glyphicon glyphicon-search"></i></span>
            <input type="text" id="searchBox" class="filter-input filter-search" placeholder="Search by dispute ID, student, item..." />
        </div>
        <select id="statusFilter" class="filter-input filter-select">
            <option value="">All Statuses</option>
            <option value="Open">Open</option>
            <option value="Under Review">Under Review</option>
            <option value="Resolved">Resolved</option>
        </select>
        <button type="button" id="btnReset" class="btn btn-filter-reset">Reset</button>
    </div>

    <!-- Full-Width Incident Register Table (100% Width) -->
    <div class="table-container">
        <div class="table-header">
            <div class="table-header-title">
                <span>Active Incident Register</span>
                <span class="record-badge" id="recordCount">4 Records</span>
            </div>
            <div class="table-header-meta">
                <span class="meta-label">Campus Tribunal</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="dispute-table" id="disputeTable">
                <thead>
                    <tr>
                        <th>Dispute ID &amp; Booking</th>
                        <th>Reporter / Subject</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th class="table-action-col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string pClass = item.Priority == "Urgent" ? "badge-urgent" : (item.Priority == "High" ? "badge-high" : "badge-medium");
                        string sClass = item.Status == "Open" ? "badge-open" : (item.Status == "Under Review" ? "badge-review" : "badge-resolved");

                        <tr class="clickable-row" data-id="@item.DisputeId" data-status="@item.Status" data-keywords="@item.DisputeId @item.BookingId @item.ItemName @item.Reporter @item.Respondent @item.Priority @item.Status">
                            <td>
                                <div class="dispute-cell-wrapper">
                                    <div class="item-img-placeholder">
                                        <i class="glyphicon glyphicon-picture"></i>
                                    </div>
                                    <div class="dispute-cell-text">
                                        <div class="dispute-cell-id">@item.DisputeId</div>
                                        <div class="dispute-cell-item">@item.ItemName</div>
                                        <div class="dispute-cell-booking">@item.BookingId</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="dispute-cell-reporter">@item.Reporter</div>
                                <div class="dispute-cell-respondent">vs @item.Respondent</div>
                            </td>
                            <td>
                                <span class="badge @pClass">@item.Priority</span>
                            </td>
                            <td>
                                <span class="badge @sClass">@item.Status</span>
                            </td>
                            <td class="table-action-col">
                                <span class="row-view-hint">View Details &rarr;</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Centered Modal Overlay Containers -->
    <div id="modalOverlay" class="modal-overlay" style="display:none;"></div>
    <div id="modalContent" class="modal-content-container" style="display:none;"></div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/dispute-management.js")"></script>
}
