@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Student Verification";
    ViewBag.ShowAdminSidebar = true;
}

@section Styles { <link rel="stylesheet" href="@Url.Content("~/Content/admin-student-verification.css")" /> }

<div class="asv-page" data-endpoint="@Url.Action("GetStudents", "AdminStudentVerification")" data-approve-url="@Url.Action("Approve", "AdminStudentVerification")" data-reject-url="@Url.Action("Reject", "AdminStudentVerification")">
    @Html.AntiForgeryToken()
    <div class="asv-feedback" data-asv-feedback role="status" aria-live="polite" hidden></div>
    <header class="asv-header">
        <h1 class="asv-header__title">Student Verification</h1>
        <p class="asv-header__subtitle">Review student ID and registration documents. Only approved students can use rental features.</p>
    </header>

    <!-- KPI CARDS -->
    <section class="asv-kpi-grid" aria-label="Verification Metrics">
        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">TOTAL STUDENTS</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--indigo" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-total>—</span></div>
        </article>

        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">PENDING VERIFICATION</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--warning" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" /><path d="M9 12h6M9 16h6" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-pending>—</span></div>
        </article>

        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">APPROVED ACCOUNTS</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--success" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-approved>—</span></div>
        </article>

        <article class="asv-kpi-card">
            <div class="asv-kpi-card__top">
                <span class="asv-kpi-card__label">REJECTED APPLICATIONS</span>
                <div class="asv-kpi-card__icon asv-kpi-card__icon--error" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
            </div>
            <div class="asv-kpi-card__value"><span data-kpi-rejected>—</span></div>
        </article>
    </section>

    <!-- TOOLBAR -->
    <section class="asv-toolbar" aria-label="Queue Controls">
        <div class="asv-toolbar__top">
            <div class="asv-search">
                <span class="asv-search__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                </span>
                <input type="text" id="asvSearchInput" class="asv-search__input" placeholder="Search student name, ID, or &#64;qcu.edu.ph email" aria-label="Search student queue" />
            </div>

            <div class="asv-toolbar__actions">
                <div class="asv-select-wrapper">
                    <span class="asv-select-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    </span>
                    <select id="asvStatusSelect" class="asv-select" aria-label="Filter by verification status">
                        <option value="PENDING" selected>Pending Review</option>
                        <option value="APPROVED">Approved</option>
                        <option value="REJECTED">Rejected</option>
                        <option value="ALL">All</option>
                    </select>
                </div>

                <button type="button" id="btnResetFilters" class="asv-btn-clear" title="Clear All Filters">Clear Filters</button>
            </div>
        </div>
    </section>

    <!-- QUEUE TABLE -->
    <article class="asv-queue-card asv-queue-card--fullwidth">
        <header class="asv-queue-card__header">
            <div>
                <h2 class="asv-queue-card__title">Queue: High Priority First</h2>
                <p class="asv-queue-card__subtitle">Most recent submissions first · Click any row to inspect the student dossier</p>
            </div>
            <div class="asv-queue-card__selected-count" data-asv-selected-count>Showing 0 Records</div>
        </header>

        <div class="asv-table-wrapper">
            <table class="asv-table" id="asvQueueTable">
                <thead>
                    <tr>
                        <th>STUDENT ID</th>
                        <th>STUDENT &amp; COURSE</th>
                        <th>CAMPUS</th>
                        <th>UNIVERSITY EMAIL</th>
                        <th>DATE REGISTERED</th>
                        <th>STATUS</th>
                        <th class="asv-th--right">ACTION</th>
                    </tr>
                </thead>
                <tbody id="asvTableBody"><tr><td colspan="7" class="asv-table__state">Loading student applications…</td></tr></tbody>
            </table>
        </div>

        <footer class="asv-queue-card__footer">
            <span class="asv-pagination-info" data-asv-pagination-info>Showing 0 of 0 submissions</span>
            <nav class="asv-pagination" data-asv-pagination aria-label="Pagination"></nav>
        </footer>
    </article>

    <!-- MODAL OVERLAY -->
    <div id="asvModalOverlay" class="asv-modal-overlay" style="display:none;" aria-hidden="true"></div>
    <div id="asvModalContainer" class="asv-modal-container" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="asvDossierTitle">
        <article class="asv-dossier asv-dossier--modal">
            <header class="asv-dossier__header">
                <div class="asv-dossier__title-group">
                    <div class="asv-dossier__header-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="9" cy="10" r="2" /><path d="M15 8h2M15 12h2M7 16h10" /></svg>
                    </div>
                    <div>
                        <span id="asvDossierTitle" class="asv-dossier__label">ACTIVE VERIFICATION DOSSIER</span>
                        <div class="asv-dossier__kyc-id" data-dossier-kyc>#KYC-0000-00000</div>
                    </div>
                </div>
                <div class="asv-dossier__header-right">
                    <span class="asv-pill asv-pill--pending" data-dossier-status-pill>Pending</span>
                    <button type="button" id="btnAsvCloseModal" class="asv-modal-close" title="Close Dossier" aria-label="Close modal">&times;</button>
                </div>
            </header>

            <div class="asv-modal-body-scroll">
                <div class="asv-dossier__identity">
                    <div class="asv-dossier__identity-row">
                        <div class="asv-avatar asv-avatar--lg asv-avatar--indigo" data-dossier-avatar aria-hidden="true">--</div>
                        <div class="asv-dossier__identity-main">
                            <h3 class="asv-dossier__name" data-dossier-name></h3>
                            <p class="asv-dossier__subtitle" data-dossier-course></p>
                            <div class="asv-dossier__badge-row">
                                <span class="asv-chip asv-chip--subtle" data-dossier-id-chip></span>
                                <span class="asv-dossier__campus" data-dossier-campus></span>
                            </div>
                        </div>
                    </div>

                    <div class="asv-dossier__meta-grid">
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">UNIVERSITY EMAIL</span>
                            <div class="asv-meta-item__value"><span data-dossier-email></span></div>
                        </div>
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">CONTACT MOBILE</span>
                            <div class="asv-meta-item__value"><span data-dossier-phone></span></div>
                        </div>
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">DATE REGISTERED</span>
                            <div class="asv-meta-item__value"><span data-dossier-registered></span></div>
                        </div>
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">APPLICATION SUBMITTED</span>
                            <div class="asv-meta-item__value"><span data-dossier-submitted></span></div>
                        </div>
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">ACCOUNT STATUS</span>
                            <div class="asv-meta-item__value"><span data-dossier-account-status></span></div>
                        </div>
                        <div class="asv-meta-item">
                            <span class="asv-meta-item__label">REVIEW NOTES</span>
                            <div class="asv-meta-item__value"><span data-dossier-review-notes></span></div>
                        </div>
                    </div>
                </div>

                <div class="asv-doc-panel" aria-live="polite"><p class="asv-document-message">Submitted documents will appear here.</p></div>
            </div>

            <footer class="asv-action-row asv-action-row--modal">
                <button type="button" class="asv-btn asv-btn--primary" data-asv-action="approve">
                    <span class="asv-btn__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12" /></svg></span>
                    <span>Approve Account</span>
                </button>
                <button type="button" class="asv-btn asv-btn--danger" data-asv-action="reject">
                    <span class="asv-btn__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></span>
                    <span>Reject</span>
                </button>
            </footer>
        </article>
    </div>

    <!-- LIGHTBOX -->
    <div id="asvLightbox" class="asv-lightbox-overlay" style="display:none;" aria-hidden="true">
        <div class="asv-lightbox-content" role="dialog" aria-modal="true" aria-label="Full-resolution document view">
            <header class="asv-lightbox-header">
                <div class="asv-lightbox-title-wrap">
                    <span class="asv-pill asv-pill--primary asv-pill--xs">INSPECTION MODE</span>
                    <span class="asv-lightbox-title">High-Resolution Document Preview</span>
                </div>
                <button type="button" id="btnAsvCloseLightbox" class="asv-lightbox-close" title="Close Inspection" aria-label="Close Lightbox">&times;</button>
            </header>
            <div id="asvLightboxBody" class="asv-lightbox-body"></div>
            <footer class="asv-lightbox-footer">
                <small class="asv-lightbox-hint">Press <strong>Esc</strong> or click anywhere outside to close</small>
            </footer>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/admin-student-verification.js")"></script>
}
