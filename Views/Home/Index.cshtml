@model UniShare.Models.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<main class="auth-card login-card" aria-labelledby="page-title">
    <div class="portal-badge"><span class="status-dot"></span> Verified Campus Portal</div>
    <div class="brand-lockup" aria-label="UniShare">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3.2a4.1 4.1 0 0 0-4.1 4.1v1.1H6.8a2 2 0 0 0-2 2v7.1a2 2 0 0 0 2 2h10.4a2 2 0 0 0 2-2v-7.1a2 2 0 0 0-2-2h-1.1V7.3A4.1 4.1 0 0 0 12 3.2Zm-2.1 5.2V7.3a2.1 2.1 0 1 1 4.2 0v1.1Zm2.1 3a2 2 0 0 1 1 3.7v1.2h-2v-1.2a2 2 0 0 1 1-3.7Z" /></svg></span>
        <span class="brand-name">UniShare</span>
    </div>
    <p class="brand-caption">Peer-to-peer campus rental network for<br /> verified students &amp; faculty</p>

    <div class="form-heading"><h1 id="page-title">Login</h1></div>
    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form login-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <div class="field-group">
            <label for="SchoolEmail">School email</label>
            <div class="input-wrap">
                <span class="field-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm9 8L3 8v11h18V8l-9 5Z" /></svg></span>
                @Html.TextBoxFor(x => x.SchoolEmail, new { type = "email", autocomplete = "username", placeholder = "name@unishare.qcu.edu.ph", required = "required" })
            </div>
            @Html.ValidationMessageFor(x => x.SchoolEmail, "", new { @class = "field-error is-visible" })
        </div>
        <div class="field-group">
            <div class="label-row"><label for="Password">Password</label><a class="text-link" href="#" data-demo-link>Forgot Password?</a></div>
            <div class="input-wrap">
                <span class="field-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 9h-1V6a4 4 0 0 0-8 0v3H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2ZM10 6a2 2 0 0 1 4 0v3h-4Zm2 6a2 2 0 0 1 1 3.7V18h-2v-2.3a2 2 0 0 1 1-3.7Z" /></svg></span>
                @Html.PasswordFor(x => x.Password, new { autocomplete = "current-password", placeholder = "Enter your password", required = "required" })
                <button class="visibility-toggle" type="button" aria-label="Show password" data-password-toggle="Password"><svg viewBox="0 0 24 24"><path d="M12 5c-5 0-9.2 3.3-11 7 1.8 3.7 6 7 11 7s9.2-3.3 11-7c-1.8-3.7-6-7-11-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /></svg></button>
            </div>
            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "field-error is-visible" })
        </div>
        <button class="primary-button" type="submit">Login <span class="button-arrow" aria-hidden="true"></span></button>
        <p class="form-footer">New to UniShare? <a class="text-link" href="@Url.Action("Register", "Account")">Sign Up</a></p>
    }
</main>

<div class="toast-message" role="status" aria-live="polite"></div>
@section pageScripts { <script src="@Url.Content("~/Scripts/auth-forms.js")"></script> }
