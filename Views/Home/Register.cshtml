@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<main class="auth-card register-card" aria-labelledby="page-title">
    <div class="register-heading-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2 3 6.5v2L12 13l9-4.5v-2L12 2Zm-7 9v5l7 3.5 7-3.5v-5l-7 3.5L5 11Zm-2 0v5h2v-5H3Z"/></svg></div>
    <h1 id="page-title">Register</h1>
    <p class="register-subtitle">Join your campus peer rental community</p>

    <form class="auth-form register-form" data-validate="true" novalidate>
        <div class="field-group"><label for="first-name">First Name</label><div class="input-wrap"><input id="first-name" name="firstName" autocomplete="given-name" placeholder="Enter first name" required /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
        <div class="field-group"><label for="last-name">Last Name</label><div class="input-wrap"><input id="last-name" name="lastName" autocomplete="family-name" placeholder="Enter last name" required /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
        <div class="field-group"><label for="username">Username</label><div class="input-wrap"><input id="username" name="username" autocomplete="username" placeholder="Choose a username" required minlength="3" /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20h1v-2h-1a8 8 0 1 1 8-8v1.5a1.5 1.5 0 0 1-3 0V13a5 5 0 1 0-2 4v.5a3.5 3.5 0 0 0 7 0V12A10 10 0 0 0 12 2Zm0 14a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
        <div class="field-group"><label for="email">Email Address</label><div class="input-wrap"><input id="email" name="email" type="email" autocomplete="email" placeholder="student@university.edu.ph" required /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm9 8L3 8v11h18V8l-9 5Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
        <div class="field-group"><label for="register-password">Password</label><div class="input-wrap"><input id="register-password" name="password" type="password" autocomplete="new-password" placeholder="Create strong password" required minlength="8" /><button class="visibility-toggle" type="button" aria-label="Show password" data-password-toggle="register-password"><svg viewBox="0 0 24 24"><path d="M12 5c-5 0-9.2 3.3-11 7 1.8 3.7 6 7 11 7s9.2-3.3 11-7c-1.8-3.7-6-7-11-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></button></div><span class="field-error" aria-live="polite"></span></div>
        <div class="field-row">
            <div class="field-group"><label for="birthdate">Birthdate</label><div class="input-wrap"><input id="birthdate" name="birthdate" type="text" inputmode="numeric" placeholder="dd/mm/yyyy" required data-date-input /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2ZM4 9v11h16V9H4Zm2 3h3v3H6v-3Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
            <div class="field-group"><label for="phone">Contact Number</label><div class="input-wrap"><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+63 900 000 0000" required /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.6 2h3l1.5 5-2 1.5a15 15 0 0 0 6.4 6.4L17 13l5 1.5v3c0 2-1.6 3.5-3.5 3.5C9.4 21 3 14.6 3 5.5 3 3.6 4.6 2 6.6 2Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
        </div>
        <div class="field-row">
            <div class="field-group"><label for="section">Section</label><div class="input-wrap"><input id="section" name="section" placeholder="e.g. BSIT-3C" required /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h18v3H3V5Zm0 5h18v3H3v-3Zm0 5h12v3H3v-3Zm14 0h4v4h-4v-4Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
            <div class="field-group"><label for="student-id">Student ID No.</label><div class="input-wrap"><input id="student-id" name="studentId" placeholder="21-00000" required /><span class="field-icon trailing" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm1 4v10h14V7H5Zm2 2h5v2H7V9Zm0 4h10v2H7v-2Z"/></svg></span></div><span class="field-error" aria-live="polite"></span></div>
        </div>
        <div class="verification-field"><span class="verification-label">Institutional Verification</span><label class="upload-control" for="school-id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a1 1 0 0 1 1 1v10l3-3 1.4 1.4-5.4 5.4-5.4-5.4L8 11l3 3V4a1 1 0 0 1 1-1ZM4 19h16v2H4v-2Z"/></svg><span data-file-name>Upload COR/ID</span><input id="school-id" name="schoolId" type="file" accept="image/*,.pdf" required data-file-input /></label><span class="field-error upload-error" aria-live="polite"></span></div>
        <button class="primary-button" type="submit">Register <span class="button-arrow" aria-hidden="true"></span></button>
        <div class="form-footer register-footer"><span>Registered? <a class="text-link" href="@Url.Action("Index", "Home")">Login</a></span></div>
    </form>
</main>

<div class="toast-message" role="status" aria-live="polite"></div>

@section pageScripts {
    <script src="@Url.Content("~/Scripts/auth-forms.js")"></script>
}
