@model UniShare.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<main class="auth-card register-card" aria-labelledby="page-title">
    <div class="register-heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 2 3 6.5v2L12 13l9-4.5v-2L12 2Zm-7 9v5l7 3.5 7-3.5v-5l-7 3.5L5 11Zm-2 0v5h2v-5H3Z" /></svg>
    </div>
    <h1 id="page-title">Create Student Account</h1>
    <p class="register-subtitle">Join the Quezon City University peer-to-peer campus rental community</p>

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "auth-form register-form" }))
    {
        @Html.AntiForgeryToken()
        if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
        {
            <div class="auth-alert error">
                @ViewData.ModelState[""].Errors.First().ErrorMessage
            </div>
        }

        <div class="field-row">
            <div class="field-group">
                <div class="label-row">
                    <label for="FirstName">First Name</label>
                    @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.FirstName, new { autocomplete = "given-name", placeholder = "Enter your first name", required = "required" })
                </div>
            </div>
            <div class="field-group">
                <div class="label-row">
                    <label for="LastName">Last Name</label>
                    @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.LastName, new { autocomplete = "family-name", placeholder = "Enter your last name", required = "required" })
                </div>
            </div>
        </div>

        <div class="field-row">
            <div class="field-group">
                <div class="label-row">
                    <label for="Username">Username</label>
                    @Html.ValidationMessageFor(x => x.Username, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.Username, new { autocomplete = "username", placeholder = "Choose a unique username", minlength = "3", required = "required" })
                </div>
            </div>
            <div class="field-group">
                <div class="label-row">
                    <label for="StudentIdNumber">Student ID Number</label>
                    @Html.ValidationMessageFor(x => x.StudentIdNumber, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.StudentIdNumber, new { placeholder = "00-0000", inputmode = "numeric", maxlength = "7", data_student_number = "true", required = "required" })
                </div>
            </div>
        </div>

        <div class="field-row">
            <div class="field-group">
                <div class="label-row">
                    <label for="SchoolEmail">School Email Address</label>
                    @Html.ValidationMessageFor(x => x.SchoolEmail, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.SchoolEmail, new { type = "email", autocomplete = "email", placeholder = "student@unishare.qcu.edu.ph", required = "required" })
                </div>
            </div>
            <div class="field-group">
                <div class="label-row">
                    <label for="Phone">Contact Number</label>
                    @Html.ValidationMessageFor(x => x.Phone, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.Phone, new { type = "tel", autocomplete = "tel", inputmode = "numeric", placeholder = "+63 900 000 0000", maxlength = "16", data_phone_mask = "true", required = "required" })
                </div>
            </div>
        </div>

        <div class="field-row">
            <div class="field-group">
                <div class="label-row">
                    <label for="Program">Program / Course</label>
                    @Html.ValidationMessageFor(x => x.Program, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.DropDownListFor(x => x.Program, new[] {
                                                new SelectListItem { Text = "Choose program / course", Value = "" },
                                                new SelectListItem { Text = "BSIT", Value = "BSIT" },
                                                new SelectListItem { Text = "BSCpE", Value = "BSCpE" },
                                                new SelectListItem { Text = "BSCE", Value = "BSCE" },
                                                new SelectListItem { Text = "BSArch", Value = "BSArch" },
                                                new SelectListItem { Text = "BSA", Value = "BSA" },
                                                new SelectListItem { Text = "BSCS", Value = "BSCS" },
                                                new SelectListItem { Text = "BSEd", Value = "BSEd" }
                                            }, new { required = "required" })
                </div>
            </div>
            <div class="field-group">
                <div class="label-row">
                    <label for="YearLevel">Year Level</label>
                    @Html.ValidationMessageFor(x => x.YearLevel, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.DropDownListFor(x => x.YearLevel, new[] {
                        new SelectListItem { Text = "Choose year level", Value = "" },
                        new SelectListItem { Text = "1st Year", Value = "1st Year" },
                        new SelectListItem { Text = "2nd Year", Value = "2nd Year" },
                        new SelectListItem { Text = "3rd Year", Value = "3rd Year" },
                        new SelectListItem { Text = "4th Year", Value = "4th Year" },
                    }, new { required = "required" })
                </div>
            </div>
        </div>

        <div class="field-row">
            <div class="field-group">
                <div class="label-row">
                    <label for="Section">Section</label>
                    @Html.ValidationMessageFor(x => x.Section, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.Section, new { placeholder = "e.g. SBIT-3D, BSIT-3C", required = "required" })
                </div>
            </div>
            <div class="field-group">
                <div class="label-row">
                    <label for="Birthdate">Birthdate</label>
                    @Html.ValidationMessageFor(x => x.Birthdate, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.TextBoxFor(x => x.Birthdate, new { inputmode = "numeric", placeholder = "DD/MM/YYYY", maxlength = "10", required = "required", data_date_input = "true" })
                </div>
            </div>
        </div>

        <div class="field-row">
            <div class="field-group">
                <div class="label-row">
                    <label for="Password">Password</label>
                    @Html.ValidationMessageFor(x => x.Password, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.PasswordFor(x => x.Password, new { autocomplete = "new-password", placeholder = "Create password (min. 8 chars)", minlength = "8", required = "required" })
                    <button class="visibility-toggle" type="button" aria-label="Show password" data-password-toggle="Password">
                        <svg viewBox="0 0 24 24"><path d="M12 5c-5 0-9.2 3.3-11 7 1.8 3.7 6 7 11 7s9.2-3.3 11-7c-1.8-3.7-6-7-11-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z" /></svg>
                    </button>
                </div>
            </div>
            <div class="field-group">
                <div class="label-row">
                    <label for="ConfirmPassword">Confirm Password</label>
                    @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "field-error" })
                </div>
                <div class="input-wrap">
                    @Html.PasswordFor(x => x.ConfirmPassword, new { autocomplete = "new-password", placeholder = "Re-enter password", required = "required" })
                </div>
            </div>
        </div>

        <div class="field-group verification-field">
            <div class="label-row">
                <label for="StudentDocument">Verification Document: Student ID OR Certificate of Registration (COR)</label>
                @Html.ValidationMessageFor(x => x.StudentDocument, "", new { @class = "field-error" })
            </div>
            <div class="upload-control">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a1 1 0 0 1 1 1v10l3-3 1.4 1.4-5.4 5.4-5.4-5.4L8 11l3 3V4a1 1 0 0 1 1-1ZM4 19h16v2H4v-2Z"/></svg>
                <span data-file-name>Upload School ID OR Registration Form (JPG, PNG, or PDF; max 8 MB)</span>
                @Html.TextBoxFor(x => x.StudentDocument, new { type = "file", accept = ".jpg,.jpeg,.png,.pdf", required = "required", data_file_input = "true" })
            </div>
        </div>

        <button class="primary-button" type="submit">Create Account <span class="button-arrow" aria-hidden="true"></span></button>
        <div class="form-footer register-footer">
            <span>Already have an account? <a class="text-link" href="@Url.Action("Login", "Account")">Sign In</a></span>
        </div>
    }
</main>

<section class="toast-message" role="status" aria-live="polite"></section>

@section pageScripts {
    <script>
        (function () {
            var fileInput = document.querySelector('[data-file-input="true"]');
            var fileNameSpan = document.querySelector('[data-file-name]');
            if (fileInput && fileNameSpan) {
                fileInput.addEventListener('change', function () {
                    if (this.files && this.files.length > 0) {
                        fileNameSpan.textContent = this.files[0].name;
                    } else {
                        fileNameSpan.textContent = "Upload School ID OR Registration Form (JPG, PNG, or PDF; max 8 MB)";
                    }
                });
            }

            function digits(value) { return value.replace(/\D/g, ""); }
            var student = document.querySelector("[data-student-number]");
            if (student) student.addEventListener("input", function () {
                var value = digits(this.value).slice(0, 6);
                this.value = value.length > 2 ? value.slice(0, 2) + "-" + value.slice(2) : value;
            });
            var phone = document.querySelector("[data-phone-mask]");
            if (phone) phone.addEventListener("input", function () {
                var value = digits(this.value);
                if (value.indexOf("63") === 0) value = value.slice(2);
                if (value.indexOf("0") === 0) value = value.slice(1);
                value = value.slice(0, 10);
                var formatted = "+63";
                if (value.length) formatted += " " + value.slice(0, 3);
                if (value.length > 3) formatted += " " + value.slice(3, 6);
                if (value.length > 6) formatted += " " + value.slice(6, 10);
                this.value = formatted;
            });
            var birthdate = document.querySelector("[data-date-input]");
            if (birthdate) birthdate.addEventListener("input", function () {
                var value = digits(this.value).slice(0, 8);
                this.value = value.length > 4 ? value.slice(0, 2) + "/" + value.slice(2, 4) + "/" + value.slice(4) : value.length > 2 ? value.slice(0, 2) + "/" + value.slice(2) : value;
            });

            document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
                button.addEventListener('click', function () {
                    var targetId = this.getAttribute('data-password-toggle');
                    var input = document.getElementById(targetId);
                    if (input) {
                        var isPassword = input.getAttribute('type') === 'password';
                        input.setAttribute('type', isPassword ? 'text' : 'password');
                    }
                });
            });
        })();
    </script>
}
