@model UniShare.Models.ItemDetailsViewModel
@{
    ViewBag.Title = "Rental Request Submitted";
    var image = Model.Gallery.Count > 0 ? Model.Gallery[0].ImageUrl : null;
    var date = (DateTime)ViewBag.HandoverDate;
    var hours = (int)ViewBag.Duration;
}
@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        .rental-page{max-width:1120px;margin:0 auto;padding:24px 20px 36px;color:#0f172a;font:13px Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.thankyou{max-width:560px;margin:30px auto;text-align:center}.success-icon{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#ecfdf5;color:#059669;font-size:23px;margin:0 auto 12px}.thankyou h1{font-size:21px;font-weight:700;margin-bottom:5px}.thankyou p{font-size:12px;color:#64748b;margin-bottom:16px}.confirm-card{background:white;border:1px solid #e2e8f0;border-radius:10px;padding:14px;margin-bottom:12px}.submitted-item{display:flex;text-align:left;gap:12px;align-items:center}.submitted-item img{width:58px;height:58px;object-fit:cover;border-radius:7px}.submitted-item strong{font-size:13px}.submitted-item div{font-size:11px;color:#64748b}.pending{margin-left:auto;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:20px;padding:4px 8px;font-size:10px}.submitted-summary{display:grid;grid-template-columns:1fr 1fr;gap:12px;text-align:left;font-size:11px}.submitted-summary small{display:block;color:#64748b;text-transform:uppercase;font-size:9px;margin-bottom:3px}.total{text-align:right;color:#4f46e5;font-weight:700;font-size:20px}.request-notice{background:#eef2ff;border:1px solid #e0e7ff;border-radius:8px;text-align:left;padding:12px;font-size:11px;color:#475569;margin:12px 0}.thankyou .submit-btn{width:100%;height:42px;border-radius:7px;display:flex;align-items:center;justify-content:center;background:#4f46e5;color:white;text-decoration:none;font:600 12px Inter,sans-serif}.back-text{display:block;margin-top:12px;color:#64748b;font-size:11px;text-decoration:none}
        @@media(max-width:600px){.rental-page{padding:16px 12px}.thankyou{margin:24px auto}.submitted-summary{grid-template-columns:1fr 1fr}}
    </style>
}
<main class="rental-page"><section class="thankyou"><div class="success-icon"><i class="bi bi-check-circle-fill"></i></div><h1>Rental Request Submitted</h1><p>Your request has been sent to the owner for review. You can track its status in Rentals.</p>
    <div class="confirm-card submitted-item">@if (!string.IsNullOrWhiteSpace(image)) { <img src="@image" alt="@Model.Name"> } else { <div class="item-photo-empty">No photo uploaded</div> }<div><strong>@Model.Title</strong><div>Owner: @Model.Lender.Name · @Model.Lender.Program</div></div><span class="pending">● Pending</span></div>
    <div class="confirm-card"><div class="submitted-summary"><div><small>Requested Handover</small>@date.ToString("ddd, MMM dd, yyyy") at @ViewBag.HandoverTime</div><div><small>Selected Duration</small>@hours hour@(hours == 1 ? "" : "s")</div><div><small>Handover Location</small><i class="bi bi-geo-alt text-primary"></i> @Model.Campus Campus · @Model.HandoverZones</div><div><small>Estimated Rental Fee</small><div class="total">₱@(((decimal)ViewBag.Total).ToString("N2"))</div></div></div></div>
    <div class="request-notice"><i class="bi bi-info-circle text-primary me-2"></i>The owner still needs to review your request. Your rental timer has not started yet because physical handover must first be confirmed in person by both parties.</div>
    <a class="submit-btn" href="@Url.Action("Index", "BorrowedItems")">View Request in Rentals <i class="bi bi-arrow-right ms-2"></i></a><a class="back-text" href="@Url.Action("Index", "BrowseItems")">Back to Items</a>
</section></main>
