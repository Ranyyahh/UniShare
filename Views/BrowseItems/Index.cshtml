                },
                {
                    id: 7, name: "White Lab Coat (Size M)", category: "Other Items", campus: "Quirino",
                    condition: "Good", hour4: 20, day: 40, rating: 4.7, reviews: 24, available: true, popular: 7, newest: 2,
                    keywords: "lab coat laboratory uniform white medtech nursing chemistry",
                    desc: "Clean, pressed white lab coat, size Medium. Required for most laboratory classes.",
                    img: "https://lh3.googleusercontent.com/aida-public/AB6AXuA9WdwOWagw7kH2v-OmWqDqxnUfADFR5p8GfOpPI1FFZ2LTiu3mfxHMb9TlTvcq7xppAN9ixvnWbJ_r9dJLdw65I2XS0UA6z2oyHZxg5Ns5rmGBywtSyXabaUE2x6LeiqGYE49FiybG6D289iNcEPXvAp7O7E8zDvYJs7BowDg5sFRYr17pQ6wYBkYQxtD6hXdqQLLmzyLTVFl4ONN9IDOObCLGtNko-y1aja16pcI"
                },
                {
                    id: 8, name: "Casio fx-991ES PLUS 2nd Ed.", category: "Electronics", campus: "San Bartolome",
                    condition: "Good", hour4: 20, day: 40, rating: 4.6, reviews: 13, available: true, popular: 8, newest: 1,
                    keywords: "casio scientific calculator fx-991es plus second edition math exam",
                    desc: "Reliable scientific calculator with natural textbook display. Light wear on the case, works perfectly.",
                    img: "https://lh3.googleusercontent.com/aida-public/AB6AXuDJ6LsA9K4An3KGvF56ga1WHFDdSQQlnx94Q8Snfl1yd_PZWnS1HuZibAq01seL1mu_DlDvAy9t2CschJF7iNagN4zLBpmi3-zDnsXp96NRuxdX5J91XiF3SzUb3CadOS4eH_6mIIjLjTBr-WHOvSpHSgekmSeqYJmVmrJCqzGbKs34VDLy-zabxENKjEoIeMrn1clujsUJ0VfPPUxI7aatkvBc7ObEcpMDr7w2g8Y"
                }
            ];

            /* ===================== STATE ===================== */
            var initialCategory = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Request.QueryString["category"] ?? ""));
            var initialApplied = defaultApplied();
            if (CATEGORIES.some(function (category) { return category.key === initialCategory; })) initialApplied.categories = [initialCategory];

            var state = {
                search: "",
                sort: "popular",
                view: "grid",
                page: 1,
                filtersOpen: false,
                applied: initialApplied
            };

            function defaultApplied() {
                return { availability: "available", categories: [], campuses: [], conditions: [], min: PRICE_MIN, max: PRICE_MAX };
            }

            /* ===================== HELPERS ===================== */
            function $(id) { return document.getElementById(id); }

            function esc(s) {
                return String(s).replace(/[&<>"']/g, function (c) {
                    return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
                });
            }

            function categoryLabel(key) {
                var c = CATEGORIES.filter(function (x) { return x.key === key; })[0];
                return c ? c.label : key;
            }

            function campusLabel(key) {
                var c = CAMPUSES.filter(function (x) { return x.key === key; })[0];
                return c ? c.label : key;
            }

            function priceText(i) {
                return "₱" + i.hour4 + " / 4 hrs • ₱" + i.day + " / day";
            }


            /* ===================== FILTER LOGIC ===================== */
            function tokens() {
                return state.search.toLowerCase().split(/\s+/).filter(Boolean);
            }

            function haystack(i) {
                return (i.name + " " + i.category + " " + categoryLabel(i.category) + " " + i.campus + " " + i.keywords).toLowerCase();
            }

            function matchesSearch(i) {
                var h = haystack(i);
                return tokens().every(function (t) { return h.indexOf(t) !== -1; });
            }

            function relevance(i) {
                var n = i.name.toLowerCase();
                return tokens().reduce(function (sum, t) { return sum + (n.indexOf(t) !== -1 ? 3 : 1); }, 0);
            }

            // skip = "category" lets us count items per category tab
            function matches(i, skip) {
                var a = state.applied;
                if (!matchesSearch(i)) return false;
                if (a.availability === "available" && !i.available) return false;
                if (skip !== "category" && a.categories.length && a.categories.indexOf(i.category) === -1) return false;
                if (a.campuses.length && a.campuses.indexOf(i.campus) === -1) return false;
                if (a.conditions.length && a.conditions.indexOf(i.condition) === -1) return false;
                if (i.day < a.min || i.day > a.max) return false;
                return true;
            }

            function sortItems(list) {
                var s = state.sort;
                return list.slice().sort(function (a, b) {
                    if (s === "price") return a.day - b.day;
                    if (s === "rating") return (b.rating - a.rating) || (b.reviews - a.reviews);
                    if (s === "newest") return b.newest - a.newest;
                    if (s === "relevance") return (relevance(b) - relevance(a)) || (a.popular - b.popular);
                    return a.popular - b.popular;
                });
            }

            function getChips() {
                var a = state.applied, chips = [];
                a.categories.forEach(function (c) { chips.push({ label: "Category: " + categoryLabel(c), type: "categories", value: c }); });
                a.campuses.forEach(function (c) { chips.push({ label: "Campus: " + campusLabel(c), type: "campuses", value: c }); });
                a.conditions.forEach(function (c) { chips.push({ label: "Condition: " + c, type: "conditions", value: c }); });
                if (a.min > PRICE_MIN || a.max < PRICE_MAX) chips.push({ label: "Rate: ₱" + a.min + " – ₱" + a.max, type: "price" });
                if (a.availability === "all") chips.push({ label: "Including rented", type: "availability" });
                return chips;
            }

            /* ===================== SIDEBAR ===================== */
            function buildSidebar() {
                $("campus-list").innerHTML = CAMPUSES.map(function (c, idx) {
                    return filterRow("campus-" + idx, "campus-filter", c.key, c.label, "cnt-campus-" + idx);
                }).join("");

                $("category-list").innerHTML = CATEGORIES.map(function (c, idx) {
                    return filterRow("cat-" + idx, "category-filter", c.key, c.label, "cnt-cat-" + idx);
                }).join("");

                $("condition-list").innerHTML = CONDITIONS.map(function (c, idx) {
                    return filterRow("cond-" + idx, "condition-filter", c, c, "cnt-cond-" + idx);
                }).join("");
            }

            function filterRow(id, cls, value, label, countId) {
                return '<div class="filter-row" id="row-' + id + '">' +
                    '<input type="checkbox" class="form-check-input ' + cls + '" id="' + id + '" value="' + esc(value) + '">' +
                    '<label for="' + id + '">' + esc(label) + '</label>' +
                    '<span class="count-pill" id="' + countId + '">0</span></div>';
            }

            function setCount(countId, rowId, n) {
                $(countId).textContent = n;
                $(rowId).classList.toggle("is-zero", n === 0);
            }

            function updateSidebarCounts() {
                var pool = ITEMS.filter(matchesSearch);
                CAMPUSES.forEach(function (c, idx) {
                    setCount("cnt-campus-" + idx, "row-campus-" + idx, pool.filter(function (i) { return i.campus === c.key; }).length);
                });
                CATEGORIES.forEach(function (c, idx) {
                    setCount("cnt-cat-" + idx, "row-cat-" + idx, pool.filter(function (i) { return i.category === c.key; }).length);
                });
                CONDITIONS.forEach(function (c, idx) {
                    setCount("cnt-cond-" + idx, "row-cond-" + idx, pool.filter(function (i) { return i.condition === c; }).length);
                });
            }

            function checkedValues(cls) {
                return Array.prototype.slice.call(document.querySelectorAll("." + cls + ":checked")).map(function (x) { return x.value; });
            }

            function readSidebar() {
                var lo = parseInt($("min-price").value, 10), hi = parseInt($("max-price").value, 10);
                if (isNaN(lo)) lo = PRICE_MIN;
                if (isNaN(hi)) hi = PRICE_MAX;
                lo = Math.max(PRICE_MIN, Math.min(lo, PRICE_MAX));
                hi = Math.max(PRICE_MIN, Math.min(hi, PRICE_MAX));
                if (lo > hi) { var t = lo; lo = hi; hi = t; }
                return {
                    availability: document.querySelector('input[name="availability"]:checked').value,
                    categories: checkedValues("category-filter"),
                    campuses: checkedValues("campus-filter"),
                    conditions: checkedValues("condition-filter"),
                    min: lo,
                    max: hi
                };
            }

            function writeSidebar() {
                var a = state.applied;
                document.querySelector('input[name="availability"][value="' + a.availability + '"]').checked = true;
                ["category-filter", "campus-filter", "condition-filter"].forEach(function (cls) {
                    var list = cls === "category-filter" ? a.categories : cls === "campus-filter" ? a.campuses : a.conditions;
                    Array.prototype.forEach.call(document.querySelectorAll("." + cls), function (el) {
                        el.checked = list.indexOf(el.value) !== -1;
                    });
                });
                setPrice(a.min, a.max);
            }

            function setPrice(lo, hi) {
                $("min-price").value = lo;
                $("max-price").value = hi;
                $("range-min").value = lo;
                $("range-max").value = hi;
                $("price-label").textContent = "₱" + lo + " – ₱" + hi + " / day";
                var span = PRICE_MAX - PRICE_MIN;
                $("range-fill").style.left = ((lo - PRICE_MIN) / span * 100) + "%";
                $("range-fill").style.width = ((hi - lo) / span * 100) + "%";
            }

            /* ===================== RENDER ===================== */
            function render() {
                var searching = state.search.length > 0;
                var a = state.applied;
                var chips = getChips();
                var applied = chips.length > 0;

                // Subtitle
                $("page-subtitle").textContent = "Borrow verified gear, academic tools, and project equipment from fellow QCU students across " +
                    (a.campuses.length ? a.campuses.join(" & ") + " " : "") + "campuses.";

                // Search box / banner
                $("search-clear").classList.toggle("d-none", !$("search-input").value);
                var results = sortItems(ITEMS.filter(function (i) { return matches(i); }));

                $("search-banner").classList.toggle("d-none", !searching);
                if (searching) {
                    $("banner-title").textContent = "Search results for \u201C" + state.search + "\u201D";
                    $("banner-count").textContent = results.length + (results.length === 1 ? " item" : " items") + " found matching your query across QCU campuses";
                }

                renderTabs(searching || applied);
                renderChips(chips);

                // Control bar
                $("filters-status").textContent = applied ? chips.length + (chips.length === 1 ? " applied" : " applied") : "Not applied yet";
                $("filter-label").textContent = state.filtersOpen ? "Hide Filters" : "Show Filters";
                $("filter-state").textContent = state.filtersOpen ? "Expanded" : "Collapsed";
                $("showing-text").innerHTML = "Showing <strong>" + results.length + "</strong> " + (searching ? "matching " : "") + (results.length === 1 ? "item" : "items");
                $("avail-badge").textContent = a.availability === "available" ? "All Available" : "Incl. Rented";

                renderSortOptions(searching);
                updateSidebarCounts();

                // Layout
                $("filter-sidebar").classList.toggle("d-none", !state.filtersOpen);
                $("results-col").className = state.filtersOpen ? "col-12 col-lg-9" : "col-12";

                // Grid
                var totalPages = Math.max(1, Math.ceil(results.length / PAGE_SIZE));
                if (state.page > totalPages) state.page = totalPages;
                var start = (state.page - 1) * PAGE_SIZE;
                var pageItems = results.slice(start, start + PAGE_SIZE);

                var colClass = state.view === "list" ? "col-12"
                    : (state.filtersOpen ? "col-12 col-sm-6 col-xl-4" : "col-12 col-sm-6 col-md-4 col-xl-3");

                var grid = $("items-grid");
                grid.classList.toggle("list-view", state.view === "list");
                grid.innerHTML = pageItems.map(function (i) { return cardHtml(i, colClass); }).join("");
                grid.classList.toggle("d-none", results.length === 0);
                $("empty-state").classList.toggle("d-none", results.length !== 0);

                // View toggle
                Array.prototype.forEach.call(document.querySelectorAll(".view-toggle .btn"), function (b) {
                    b.classList.toggle("active", b.getAttribute("data-view") === state.view);
                });

                renderPagination(results.length, start, pageItems.length, totalPages);
            }

            function cardHtml(i, colClass) {
                return '<div class="' + colClass + '">' +
                    '<article class="item-card">' +
                    '<div class="item-media">' +
                    '<img src="' + esc(i.img) + '" alt="' + esc(i.name) + '" loading="lazy">' +
                    '<span class="cond-pill">Condition: ' + esc(i.condition) + '</span>' +
                    (i.available ? '' : '<span class="rented-pill">Rented</span>') +
                    '</div>' +
                    '<div class="item-body">' +
                    '<h3 class="item-title">' + esc(i.name) + '</h3>' +
                    '<div class="item-price">' + priceText(i) + '</div>' +
                    '<div class="item-rating"><i class="bi bi-star-fill"></i> <strong>' + i.rating.toFixed(1) + '</strong> (' + i.reviews + ' reviews)</div>' +
                    '<a class="btn btn-soft view-details" href="' + DETAILS_URL.replace("__ID__", i.id) + '">View Details <i class="bi bi-arrow-right"></i></a>' +
                    '</div></article></div>';
            }

            function renderTabs(show) {
                var wrap = $("category-tabs");
                wrap.classList.toggle("d-none", !show);
                if (!show) return;

                var pool = ITEMS.filter(function (i) { return matches(i, "category"); });
                var sel = state.applied.categories;
                var html = '<button type="button" class="cat-tab' + (sel.length === 0 ? " active" : "") + '" data-cat="">All Items <span class="tab-count">' + pool.length + '</span></button>';

                CATEGORIES.forEach(function (c) {
                    var n = pool.filter(function (i) { return i.category === c.key; }).length;
                    var active = sel.length === 1 && sel[0] === c.key;
                    html += '<button type="button" class="cat-tab' + (active ? " active" : "") + '" data-cat="' + esc(c.key) + '">' +
                        (active ? '<i class="bi bi-check2"></i>' : '') + esc(c.label) + ' <span class="tab-count">' + n + '</span></button>';
                });
                wrap.innerHTML = html;
            }

            function renderChips(chips) {
                var wrap = $("active-filters");
                wrap.classList.toggle("d-none", chips.length === 0);
                if (!chips.length) return;

                wrap.innerHTML = '<span class="text-secondary fw-semibold"><i class="bi bi-sliders me-1 text-primary"></i>Active Filters:</span>' +
                    chips.map(function (c, idx) {
                        return '<span class="filter-chip">' + esc(c.label) +
                            '<button type="button" data-chip="' + idx + '" aria-label="Remove filter">&times;</button></span>';
                    }).join("") +
                    '<button type="button" class="btn btn-link btn-sm text-decoration-none ms-auto p-0 fw-semibold" id="chips-clear" style="color:var(--primary)">Clear all</button>';
            }

            function renderSortOptions(searching) {
                var opts = [
                    ["popular", "Most Popular"],
                    ["price", "Lowest Rental Rate"],
                    ["rating", "Highest Rated"],
                    ["newest", "Newest Arrivals"]
                ];
                if (searching) opts.unshift(["relevance", "Relevance (Best Match)"]);
                if (!searching && state.sort === "relevance") state.sort = "popular";

                var sel = $("sort-select");
                sel.innerHTML = opts.map(function (o) {
                    return '<option value="' + o[0] + '"' + (o[0] === state.sort ? " selected" : "") + '>' + o[1] + '</option>';
                }).join("");
            }

            function renderPagination(total, start, count, totalPages) {
                var cats = state.applied.categories;
                var scope = cats.length ? "in " + cats.map(categoryLabel).join(", ") : "without category filter";

                $("pagination-text").textContent = total === 0
                    ? "No items to display"
                    : "Viewing " + (start + 1) + "\u2013" + (start + count) + " of " + total + " items " + scope;

                var html = '<button type="button" class="btn" data-page="' + (state.page - 1) + '"' + (state.page <= 1 ? " disabled" : "") + '>Previous</button>';
                for (var p = 1; p <= totalPages; p++) {
                    html += '<button type="button" class="btn' + (p === state.page ? " active" : "") + '" data-page="' + p + '">' + p + '</button>';
                }
                html += '<button type="button" class="btn" data-page="' + (state.page + 1) + '"' + (state.page >= totalPages ? " disabled" : "") + '>Next</button>';
                $("pager").innerHTML = html;
            }

            /* ===================== ACTIONS ===================== */
            function setSearch(value) {
                var had = state.search.length > 0;
                state.search = value.trim();
                if (state.search && !had && state.sort === "popular") state.sort = "relevance";
                if (!state.search && state.sort === "relevance") state.sort = "popular";
                state.page = 1;
                render();
            }

            function clearSearch() {
                $("search-input").value = "";
                setSearch("");
            }

            function resetFilters() {
                state.applied = defaultApplied();
                state.page = 1;
                writeSidebar();
                render();
            }

            function applyFilters() {
                state.applied = readSidebar();
                state.page = 1;
                writeSidebar();
                render();
            }

            /* ===================== EVENTS ===================== */
            var debounce;
            $("search-input").addEventListener("input", function () {
                $("search-clear").classList.toggle("d-none", !this.value);
                var v = this.value;
                clearTimeout(debounce);
                debounce = setTimeout(function () { setSearch(v); }, 250);
            });

            $("search-input").addEventListener("keydown", function (e) {
                if (e.key === "Enter") { clearTimeout(debounce); setSearch(this.value); }
            });

            $("search-button").addEventListener("click", function () {
                clearTimeout(debounce);
                setSearch($("search-input").value);
            });

            $("search-clear").addEventListener("click", function () { clearSearch(); $("search-input").focus(); });
            $("back-to-all").addEventListener("click", function (e) { e.preventDefault(); clearSearch(); });

            $("toggle-filters").addEventListener("click", function () {
                state.filtersOpen = !state.filtersOpen;
                render();
            });

            $("apply-filters").addEventListener("click", applyFilters);
            $("clear-filters").addEventListener("click", resetFilters);
            $("clear-all").addEventListener("click", resetFilters);

            $("empty-reset").addEventListener("click", function () {
                $("search-input").value = "";
                state.search = "";
                if (state.sort === "relevance") state.sort = "popular";
                resetFilters();
            });

            $("sort-select").addEventListener("change", function () {
                state.sort = this.value;
                state.page = 1;
                render();
            });

            document.querySelector(".view-toggle").addEventListener("click", function (e) {
                var btn = e.target.closest("[data-view]");
                if (!btn) return;
                state.view = btn.getAttribute("data-view");
                render();
            });

            // Category tabs (apply immediately and sync sidebar)
            $("category-tabs").addEventListener("click", function (e) {
                var tab = e.target.closest(".cat-tab");
                if (!tab) return;
                var cat = tab.getAttribute("data-cat");
                state.applied.categories = cat ? [cat] : [];
                state.page = 1;
                writeSidebar();
                render();
            });

            // Active filter chips
            $("active-filters").addEventListener("click", function (e) {
                if (e.target.id === "chips-clear") { resetFilters(); return; }
                var btn = e.target.closest("[data-chip]");
                if (!btn) return;
                var chip = getChips()[parseInt(btn.getAttribute("data-chip"), 10)];
                var a = state.applied;
                if (chip.type === "price") { a.min = PRICE_MIN; a.max = PRICE_MAX; }
                else if (chip.type === "availability") { a.availability = "available"; }
                else { a[chip.type] = a[chip.type].filter(function (v) { return v !== chip.value; }); }
                state.page = 1;
                writeSidebar();
                render();
            });

            // Pagination
            $("pager").addEventListener("click", function (e) {
                var btn = e.target.closest("[data-page]");
                if (!btn || btn.disabled) return;
                state.page = parseInt(btn.getAttribute("data-page"), 10);
                render();
                window.scrollTo({ top: 0, behavior: "smooth" });
            });

            // Price sliders / inputs
            $("range-min").addEventListener("input", function () {
                var lo = parseInt(this.value, 10), hi = parseInt($("range-max").value, 10);
                if (lo > hi) lo = hi;
                setPrice(lo, hi);
            });

            $("range-max").addEventListener("input", function () {
                var hi = parseInt(this.value, 10), lo = parseInt($("range-min").value, 10);
                if (hi < lo) hi = lo;
                setPrice(lo, hi);
            });

            ["min-price", "max-price"].forEach(function (id) {
                $(id).addEventListener("change", function () {
                    var cur = readSidebar();
                    setPrice(cur.min, cur.max);
                });
            });

            /* ===================== INIT ===================== */
            buildSidebar();
            writeSidebar();
            render();
        })();
    </script>
}
