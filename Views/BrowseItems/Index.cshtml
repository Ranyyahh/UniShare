                    desc: "HDMI, USB-A, SD/microSD and USB-C power passthrough. Handy for presentations and project demos.",
                    img: "https://lh3.googleusercontent.com/aida-public/AB6AXuA14k44VRTZh1TLEpfoOTL9DDpZqp3lScIsxbMbpQHBR7btU6kSZsMmwzq0n6gHS-pSCHydbiDC8BlRgErvoxGtWvpQWiHlU2ehmU8e2ec6Qp5hAq6mXl3hvmKSw5PWUb8ft1XMj_rXgGBMC9onN-zzBYeAZVIZDQ0N95KU4f_XPIqS5xFkQCQfTNz3pqHoeWjhr4xsfMh2wTnFNxkezqckLoEjGANJx1rP47hW__w"
