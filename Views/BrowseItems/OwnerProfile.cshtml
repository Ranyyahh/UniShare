@model UniShare.Models.OwnerProfileViewModel
@using System.Linq
@{
    ViewBag.Title = Model.Name + " | Owner Profile";
    var categories = Model.Listings.Select(x => x.CategoryLabel).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList();
}

@section Styles {
    <link href="@Url.Content("~/Content/items.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/OwnerProfile.css")" rel="stylesheet" />
}

<main class="owner-profile-page">
    <a class="op-back" href="@Url.Action("Index", "BrowseItems")"><span aria-hidden="true">←</span> Browse items</a>
    <section class="op-hero mt-3">
        <div class="op-identity">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePhoto))
            {
                <img src="@Url.Content(Model.ProfilePhoto)" alt="@Model.Name" class="op-avatar" />
            }
            else
            {
                <div class="op-avatar op-avatar--initials" aria-hidden="true">@Model.Initials</div>
            }
            <div class="op-owner-copy">
                <div class="op-name-line">
                    <h1>@Model.Name</h1>
                    @if (Model.Rating.HasValue)
                    {
                        <span class="op-owner-rating" aria-label="Owner rating @Model.Rating.Value.ToString("0.0") out of 5">
                            <span aria-hidden="true">★</span> @Model.Rating.Value.ToString("0.0") <small>(@Model.ReviewCount)</small>
                        </span>
                    }
                    @if (Model.IsVerified) { <span class="op-verified"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> Verified student</span> }
                </div>
                <div class="op-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.Campus)) { <span><i class="bi bi-geo-alt" aria-hidden="true"></i>@Model.Campus</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.Program)) { <span>@Model.Program</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.YearLevel)) { <span>@Model.YearLevel</span> }
                </div>
                <div class="op-stats">
                    <span><strong>@Model.CompletedRentals</strong> completed rentals</span>
                    <span><strong>@Model.Listings.Count</strong> available listings</span>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Bio)) { <p class="op-bio">@Model.Bio</p> }
    </section>

    <section class="op-section" aria-labelledby="ownerListingsTitle">
        <div class="op-section-heading">
            <div>
                <span class="op-eyebrow">Marketplace</span>
                <h2 id="ownerListingsTitle">Available listings</h2>
                <p><span id="owner-visible-count">@Model.Listings.Count</span> of @Model.Listings.Count items</p>
            </div>
        </div>

        <div class="owner-profile-tools">
            <label class="op-search"><span class="visually-hidden">Search this owner's items</span><i class="bi bi-search" aria-hidden="true"></i>
                <input id="owner-item-search" type="search" placeholder="Search items, categories, or condition" aria-label="Search this owner's items" />
            </label>
            <select id="owner-category-filter" aria-label="Filter by category">
                <option value="">All categories</option>
                @foreach (var category in categories) { <option value="@category">@category</option> }
            </select>
            <select id="owner-condition-filter" aria-label="Filter by condition">
                <option value="">All conditions</option>
                @foreach (var condition in new[] { "Like New", "Good", "Fair", "Heavy Use" }) { <option value="@condition">@condition</option> }
            </select>
            <button type="button" class="owner-profile-reset" id="owner-filter-reset">Clear filters</button>
        </div>

        @if (Model.Listings.Count == 0)
        {
            <div class="op-empty op-empty--listings">This owner has no available listings right now.</div>
        }
        else
        {
            <div class="row g-4" id="owner-listings-grid">
                @foreach (var item in Model.Listings)
                {
                    <div class="col-sm-6 col-xl-4 owner-listing-result" data-title="@item.Title" data-category="@item.CategoryLabel" data-condition="@item.Condition">
                        <a class="owner-listing-card" href="@Url.Action("ItemDetails", "BrowseItems", new { id = item.Id })">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@Url.Content(item.ImageUrl)" alt="@item.Title" loading="lazy" /> }
                            else { <div class="owner-listing-placeholder">No photo uploaded</div> }
                            <div class="op-listing-copy">
                                <div class="op-listing-meta"><span>@item.CategoryLabel</span><span>@item.Condition</span></div>
                                <h3>@item.Title</h3>
                                <div class="op-listing-price">₱@((item.Price / Math.Max(1, item.PerHours)).ToString("0.00")) <small>/ hr</small></div>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <div class="op-empty op-empty--listings" id="owner-listings-empty" hidden>No listings match your search and filters.</div>
        }
    </section>

    <section class="op-section op-reviews-section" aria-labelledby="ownerReviewsTitle">
        <div class="op-section-heading">
            <div><span class="op-eyebrow">Community feedback</span><h2 id="ownerReviewsTitle">Student Reviews</h2><p>@Model.Reviews.Count review@(Model.Reviews.Count == 1 ? "" : "s")</p></div>
        </div>
        @if (Model.Reviews.Count == 0)
        {
            <div class="op-empty">No reviews have been submitted for this owner yet.</div>
        }
        else
        {
            <div class="op-review-list">
                @foreach (var review in Model.Reviews)
                {
                    <article class="op-review-card">
                        <div class="op-review-head">
                            <div class="op-review-author"><strong>@review.ReviewerName</strong><time datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">@review.CreatedAt.ToString("MMM d, yyyy")</time></div>
                            <div class="op-review-ratings">
                                @if (review.OwnerRating.HasValue) { <span><small>Owner</small> ★ @review.OwnerRating.Value.ToString("0.0")</span> }
                                @if (review.ItemRating.HasValue) { <span><small>Item</small> ★ @review.ItemRating.Value.ToString("0.0")</span> }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.Review))
                        {
                            <p class="op-review-text">@review.Review</p>
                        }
                        @if (Request.IsAuthenticated)
                        {
                            using (Html.BeginForm("Report", "ReviewReports", FormMethod.Post, new { @class = "d-flex flex-wrap gap-2 mt-3" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@review.Id" />
                                <input type="hidden" name="returnUrl" value="@Request.Url.PathAndQuery" />
                                <input class="form-control form-control-sm" type="text" name="reason" maxlength="500" required placeholder="Why should this review be checked?" style="max-width:320px" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Report review</button>
                            }
                        }
                    </article>
                }
            </div>
        }
    </section>
</main>

@section scripts {
    <script>
        (function () {
            var search = document.getElementById('owner-item-search');
            var category = document.getElementById('owner-category-filter');
            var condition = document.getElementById('owner-condition-filter');
            var reset = document.getElementById('owner-filter-reset');
            var cards = Array.prototype.slice.call(document.querySelectorAll('.owner-listing-result'));
            if (!search || !category || !condition) return;
            function apply() {
                var term = search.value.trim().toLowerCase();
                var visible = 0;
                cards.forEach(function (card) {
                    var searchable = [card.dataset.title, card.dataset.category, card.dataset.condition].join(' ').toLowerCase();
                    var matches = searchable.indexOf(term) !== -1 &&
                        (!category.value || card.dataset.category === category.value) &&
                        (!condition.value || card.dataset.condition === condition.value);
                    card.classList.toggle('owner-profile-hidden', !matches);
                    if (matches) visible++;
                });
                document.getElementById('owner-visible-count').textContent = visible;
                var empty = document.getElementById('owner-listings-empty');
                if (empty) empty.hidden = visible > 0;
            }
            search.addEventListener('input', apply);
            category.addEventListener('change', apply);
            condition.addEventListener('change', apply);
            if (reset) reset.addEventListener('click', function () { search.value = ''; category.value = ''; condition.value = ''; apply(); search.focus(); });
        })();
    </script>
}
