@model UniShare.Models.ItemDetailsViewModel
@using System.Linq
@{
    ViewBag.Title = "Request Form";
    var image = Model.Gallery.Count > 0 ? Model.Gallery[0].ImageUrl : null;
    var today = DateTime.Today;
}
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        .rental-page{max-width:1120px;margin:0 auto;padding:24px 20px 36px;color:#0f172a;font:13px Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.rental-page *{box-sizing:border-box}.rental-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.rental-head h1{font-size:22px;font-weight:700;margin:0 0 3px;letter-spacing:-.03em}.rental-sub{font-size:12px;color:#64748b}.rental-card{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:18px;margin-bottom:14px}.rental-item{display:flex;align-items:center;gap:14px;padding:12px}.rental-item img{width:72px;height:72px;object-fit:cover;border-radius:8px}.rental-item-main{flex:1;min-width:0}.rental-item-title{font-weight:700;margin-bottom:4px}.rental-meta{font-size:11px;color:#64748b;line-height:1.7}.rental-rate{border-left:1px solid #e2e8f0;padding-left:20px;text-align:right;color:#64748b;font-size:10px;text-transform:uppercase}.rental-rate strong{display:block;color:#4f46e5;font-size:16px;text-transform:none}.rental-section-title{font-size:15px;font-weight:700;margin:0 0 3px}.rental-section-sub{font-size:11px;color:#64748b;margin-bottom:16px}.rental-step{font-size:11px;font-weight:700;margin:12px 0 7px}.duration-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:7px}.duration-btn,.date-nav,.time-select,.notes-field{border:1px solid #e2e8f0;background:#fff;border-radius:6px;color:#334155}.duration-btn{height:38px;font-size:12px}.duration-btn.active,.submit-btn{background:#4f46e5;color:white;border-color:#4f46e5}.schedule-cols{display:grid;grid-template-columns:1.05fr .95fr;gap:14px;margin-top:14px}.calendar,.time-panel{border:1px solid #e2e8f0;border-radius:8px;padding:12px}.calendar-top{display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:12px;margin-bottom:10px}.calendar-top button{width:26px;height:26px}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center}.calendar-grid span,.calendar-grid button{font-size:10px;color:#64748b;padding:7px 2px}.calendar-grid button{border:0;background:transparent;border-radius:5px}.calendar-grid button:disabled{opacity:.35}.calendar-grid button.selected{background:#4f46e5;color:white}.calendar-grid button.booked{color:#d97706}.time-select{width:100%;height:38px;padding:0 10px}.times{margin-top:8px;border:1px solid #e2e8f0;border-radius:7px;overflow:hidden}.times button{width:100%;padding:9px 10px;text-align:left;background:white;border:0;border-bottom:1px solid #f1f5f9;font-size:11px;color:#334155}.times button:last-child{border-bottom:0}.times button.selected{background:#eef2ff;color:#4338ca}.times button:disabled{color:#94a3b8;text-decoration:line-through}.location-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.location-box{padding:12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:7px;font-size:11px}.location-box b{display:block;color:#64748b;font-size:9px;text-transform:uppercase;margin-bottom:4px}.notes-field{width:100%;min-height:74px;padding:10px;font:12px Inter, sans-serif;resize:vertical}.fee-row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #f1f5f9;color:#475569;font-size:12px}.fee-total{display:flex;justify-content:space-between;align-items:center;padding-top:12px;font-weight:700}.fee-total strong{font-size:22px;color:#4f46e5}.rental-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px}.rental-actions button,.rental-actions a,.back-btn{height:42px;border-radius:7px;display:flex;align-items:center;justify-content:center;text-decoration:none;font:600 12px Inter,sans-serif}.submit-btn{border:1px solid #4f46e5}.cancel-btn,.back-btn{background:white;border:1px solid #e2e8f0;color:#0f172a}.small-caption{font-size:10px;color:#64748b}.availability-hint{font-size:10px;color:#64748b;text-align:right}.thankyou{max-width:560px;margin:48px auto;text-align:center}.success-icon{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#ecfdf5;color:#059669;font-size:23px;margin:0 auto 12px}.thankyou h1{font-size:21px;font-weight:700}.submitted-item{display:flex;text-align:left;gap:12px;align-items:center}.submitted-item img{width:58px;height:58px;object-fit:cover;border-radius:7px}.submitted-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left;font-size:11px}.submitted-summary small{display:block;color:#64748b;text-transform:uppercase;font-size:9px;margin-bottom:3px}.submitted-total{text-align:right;color:#4f46e5;font-weight:700;font-size:20px}.request-notice{background:#eef2ff;border:1px solid #e0e7ff;border-radius:8px;text-align:left;padding:12px;font-size:11px;color:#475569;margin:12px 0}.thankyou .submit-btn{width:100%;text-decoration:none}.thankyou .back-text{display:block;margin-top:12px;color:#64748b;font-size:11px;text-decoration:none}
        @@media(max-width:700px){.rental-page{padding:16px 12px 28px}.rental-card{padding:14px}.duration-grid{grid-template-columns:repeat(4,1fr)}.schedule-cols,.location-grid{grid-template-columns:1fr}.rental-item img{width:58px;height:58px}.rental-rate{padding-left:10px}.rental-head h1{font-size:19px}.thankyou{margin:28px 12px}}
    </style>
}
<main class="rental-page">
    <div class="rental-head"><div><h1>Request Form</h1><div class="rental-sub">Review the item details and rental schedule before sending your request.</div></div><a class="back-btn" style="padding:0 13px" href="@Url.Action("ItemDetails", new { id = Model.ItemId })"><i class="bi bi-arrow-left me-2"></i>Back to Items</a></div>
    <div class="rental-card rental-item">@if (!string.IsNullOrWhiteSpace(image)) { <img src="@image" alt="@Model.Name"> } else { <div class="item-photo-empty">No photo uploaded</div> }<div class="rental-item-main"><div class="rental-item-title">@Model.Title @if (Model.Rating.HasValue) { <span style="color:#f59e0b">★ @Model.Rating.Value.ToString("0.0")</span> }</div><div class="rental-meta">@Model.Lender.Name · @Model.Lender.Program · @Model.Lender.College<br><i class="bi bi-geo-alt"></i> @Model.Campus Campus · @Model.HandoverZones</div></div><div class="rental-rate">Rental Rate<strong>₱@Model.HourlyRate.ToString("0.00") <span style="font-size:10px;color:#64748b">/ hour</span></strong></div></div>
    @using (Html.BeginForm("RequestToRent", "BrowseItems", FormMethod.Post, new { id = "rental-form" }))
    {
        @Html.ValidationSummary(false, "Please review the request details.", new { @class = "alert alert-danger" })
        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ItemId"/><input type="hidden" name="duration" id="duration" value="2"/><input type="hidden" name="handoverDate" id="handover-date" value="@today.ToString("yyyy-MM-dd")"/><input type="hidden" name="handoverTime" id="handover-time" value="09:00 AM"/>
        <section class="rental-card"><h2 class="rental-section-title"><i class="bi bi-calendar3 text-primary me-2"></i>Rental Schedule</h2><div class="rental-section-sub">Unavailable dates, times, and rental durations are disabled when they overlap with an existing booking. Choose an available schedule to continue.</div><div class="d-flex justify-content-between align-items-center"><div class="rental-step">1. Rental Duration</div><div class="availability-hint">Paid usage period (Max. 24 hours per booking)</div></div><div class="duration-grid">@foreach (var hours in new[] { 1, 2, 3, 4, 6, 8, 12, 24 }) { <button type="button" class="duration-btn @(hours == 2 ? "active" : "")" data-hours="@hours">@hours h</button> }</div>
        <div class="schedule-cols"><div><div class="rental-step">2. Preferred Handover Date</div><div class="calendar"><div class="calendar-top"><span id="month-label"></span><span><button type="button" class="date-nav" id="prev-month">‹</button> <button type="button" class="date-nav" id="next-month">›</button></span></div><div class="calendar-grid" id="calendar-grid"></div><div class="small-caption mt-2">● Available for Rent　 <span style="color:#f59e0b">●</span> Booked / In Handover　 <span style="color:#4f46e5">●</span> Selected Date</div></div></div>
        <div><div class="rental-step">3. Preferred Handover Time</div><select class="time-select" id="time-select"><option>09:00 AM</option><option>10:00 AM</option><option>11:00 AM</option><option>12:00 PM</option><option>01:00 PM</option><option>02:00 PM</option><option>03:00 PM</option><option>04:00 PM</option></select><div class="small-caption mt-2">Available handover times are shown in the list.</div></div></div>
        <div class="location-grid"><div class="location-box"><b><i class="bi bi-geo-alt text-primary me-1"></i>Handover Location</b>@Model.Campus Campus · @Model.HandoverZones</div><div class="location-box" style="background:#f5f7ff"><b><i class="bi bi-calendar-check text-primary me-1"></i>Expected Return Time</b><span id="return-time"></span></div></div></section>
        <section class="rental-card"><div class="d-flex justify-content-between"><h2 class="rental-section-title">Notes to Owner (Optional)</h2><span class="small-caption">Optional</span></div><textarea class="notes-field" name="notes" maxlength="300" placeholder="e.g., Hi Marco! I need this for my exam at 10 AM. Can meet at the lobby steps."></textarea><div class="small-caption mt-2">Optional. Share meeting preferences or schedule details. The system does not automatically enforce notes.</div></section>
        <section class="rental-card"><h2 class="rental-section-title">Rental Fee Summary</h2><div class="fee-row"><span>Rental Rate</span><strong>₱@Model.HourlyRate.ToString("0.00") / hr</strong></div><div class="fee-row"><span>Rental Duration</span><strong id="duration-label">2 hours</strong></div><div class="fee-total"><span>Estimated Rental Fee</span><strong id="fee-total">₱@((Model.HourlyRate * 2).ToString("0.00"))</strong></div></section>
        <div class="rental-actions"><button type="submit" class="submit-btn"><i class="bi bi-send me-2"></i>Submit Rental Request</button><a class="cancel-btn" href="@Url.Action("ItemDetails", new { id = Model.ItemId })">Cancel</a></div>
    }
</main>
@section Scripts {
<script>
(function(){var rate=@Model.HourlyRate.ToString(System.Globalization.CultureInfo.InvariantCulture),booked=@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BookedDates.Select(d => d.ToString("yyyy-MM-dd")))),selected=new Date(),month=new Date(selected.getFullYear(),selected.getMonth(),1);while(booked.indexOf(selected.getFullYear()+'-'+String(selected.getMonth()+1).padStart(2,'0')+'-'+String(selected.getDate()).padStart(2,'0'))>=0)selected.setDate(selected.getDate()+1);function fmt(d){return d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'})}function update(){var h=+document.getElementById('duration').value,t=document.getElementById('time-select').value;document.getElementById('duration-label').textContent=h+' hour'+(h===1?'':'s');document.getElementById('fee-total').textContent='₱'+(rate*h).toFixed(2);var start=new Date(selected);var parts=t.match(/(\d+):(\d+) (AM|PM)/);var hour=+parts[1]%12+(parts[3]==='PM'?12:0);start.setHours(hour,+parts[2]);var end=new Date(start.getTime()+h*3600000);document.getElementById('return-time').textContent=fmt(end)+' · '+end.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})+' ('+h+'-hour rental)';document.getElementById('handover-date').value=selected.getFullYear()+'-'+String(selected.getMonth()+1).padStart(2,'0')+'-'+String(selected.getDate()).padStart(2,'0');document.getElementById('handover-time').value=t}function render(){document.getElementById('month-label').textContent=month.toLocaleDateString('en-US',{month:'long',year:'numeric'});var grid=document.getElementById('calendar-grid');grid.innerHTML='';['Su','Mo','Tu','We','Th','Fr','Sa'].forEach(function(x){var s=document.createElement('span');s.textContent=x;grid.appendChild(s)});var first=month.getDay(),days=new Date(month.getFullYear(),month.getMonth()+1,0).getDate();for(var i=0;i<first;i++)grid.appendChild(document.createElement('span'));for(var d=1;d<=days;d++){var date=new Date(month.getFullYear(),month.getMonth(),d),b=document.createElement('button');b.type='button';b.textContent=d;var key=date.getFullYear()+'-'+String(date.getMonth()+1).padStart(2,'0')+'-'+String(d).padStart(2,'0'),isBooked=booked.indexOf(key)>=0;if(date<new Date(new Date().setHours(0,0,0,0))||isBooked)b.disabled=true;if(isBooked)b.classList.add('booked');if(date.toDateString()===selected.toDateString())b.classList.add('selected');b.addEventListener('click',function(dt){return function(){selected=dt;render();update()}}(date));grid.appendChild(b)}}document.getElementById('prev-month').onclick=function(){month.setMonth(month.getMonth()-1);render()};document.getElementById('next-month').onclick=function(){month.setMonth(month.getMonth()+1);render()};document.querySelectorAll('.duration-btn').forEach(function(b){b.onclick=function(){document.querySelectorAll('.duration-btn').forEach(function(x){x.classList.remove('active')});b.classList.add('active');document.getElementById('duration').value=b.dataset.hours;update()}});document.getElementById('time-select').onchange=update;render();update()})();
</script>
}
