@model UniShare.Models.ItemDetailsViewModel
@{
    ViewBag.Title = Model.Name;
    var first = Model.Gallery[0];
}

@section Styles {
    <!-- If your _Layout already loads Bootstrap 5 + Bootstrap Icons, remove those two links. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/items.css")" rel="stylesheet">
}

<main class="browse-container container-xxl">

    <!-- Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <nav class="crumbs">
            <a href="@Url.Action("Index", "BrowseItems")"><i class="bi bi-arrow-left me-1"></i>Back to Browse Items</a>
            <span>/</span>
            <span>@Model.Subcategory</span>
            <span>/</span>
            <strong class="text-body">@Model.Name</strong>
        </nav>
        <span class="id-chip">Item ID: @Model.ItemCode</span>
    </div>

    <div class="row g-4">

        <!-- LEFT: gallery + handover -->
        <div class="col-lg-6">
            <div class="d-card">
                <div class="gal-main">
                    <img id="g-main" src="@first.ImageUrl" alt="@Model.Name" style="transform:@first.Transform;transform-origin:@first.TransformOrigin">
                    <span class="gal-badge tl"><i class="bi bi-patch-check me-1"></i>Actual Item Condition</span>
                    <span class="gal-badge br"><i class="bi bi-geo-alt me-1 text-primary"></i>@Model.Campus Campus</span>
                </div>

                <div class="gal-thumbs">
                    @for (var g = 0; g < Model.Gallery.Count; g++)
                    {
                        var th = Model.Gallery[g];
                        var thumbClass = g == 0 ? "gal-thumb active" : "gal-thumb";
                        <button type="button" class="@thumbClass" data-transform="@th.Transform" data-origin="@th.TransformOrigin">
                            <img src="@th.ImageUrl" alt="@th.Label" style="transform:@th.Transform;transform-origin:@th.TransformOrigin">
                            <span>@th.Label</span>
                        </button>
                    }
                </div>
            </div>

            <div class="d-card handover">
                <div class="h-ico"><i class="bi bi-shield-check"></i></div>
                <div>
                    <strong>Guaranteed Safe Campus Handover</strong><span class="reg-badge">QCU REGULATED</span>
                    <p class="mb-0 mt-1">
                        All peer rentals must occur at designated QCU security zones: <strong>@Model.HandoverZones</strong>. Never meet outside campus perimeter.
                    </p>
                </div>
            </div>
        </div>

        <!-- RIGHT: details -->
        <div class="col-lg-6">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="tag blue">@Model.CategoryLabel</span>
                <span class="tag green">
                    <i class="bi bi-circle-fill me-1" style="font-size:.4rem;vertical-align:middle"></i>@(Model.IsAvailable ? "Available Now" : "Currently Rented")
                </span>
                <span class="tag">@Model.Condition (@(Model.ConditionScore.ToString("0.0"))/10)</span>
                <span class="ms-auto small text-secondary">Listed @Model.ListedText</span>
            </div>

            <h1 class="d-title mb-2">@Model.Title</h1>

            <div class="small mb-3">
                <i class="bi bi-star-fill" style="color:#f5a524"></i> <strong>@Model.Rating.ToString("0.0")</strong>
                <span class="text-secondary">(@Model.ReviewCount reviews)</span>
                <span class="mx-2 text-secondary">|</span>
                <span class="text-success fw-semibold"><i class="bi bi-patch-check me-1"></i>High Reliability</span>
            </div>

            <!-- Rate card -->
            <div class="d-card rate-card">
                <div class="rate-label">CAMPUS RENTAL RATE</div>
                <div class="d-flex justify-content-between align-items-end">
                    <div><span class="rate-price">₱@Model.HourlyRate.ToString("0.##")</span> <span class="text-secondary">/ hr</span></div>
                    <span class="state-badge">Hourly rate only</span>
                </div>
                <div class="small my-3">
                    <i class="bi bi-circle-fill text-success me-2" style="font-size:.45rem;vertical-align:middle"></i><i class="bi bi-clock text-success me-2"></i>Available today: <strong>@Model.AvailableHours</strong>
                </div>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <button type="button" id="d-check" class="btn btn-outline-soft w-100 py-2"><i class="bi bi-calendar-event me-2 text-primary"></i>Check Availability</button>
                    </div>
                    <div class="col-sm-6">
                        @if (ViewBag.IsStudentVerified == true)
                        {
                            <button type="button" id="d-request" class="btn btn-brand w-100 py-2" @(Model.IsAvailable ? "" : "disabled")>Request to Rent <i class="bi bi-arrow-right ms-1"></i></button>
                        }
                        else if (ViewBag.IsAuthenticated == true)
                        {
                            <a class="btn btn-outline-soft w-100 py-2" href="@Url.Action("Status", "Verification")">Verify your student account to rent</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-soft w-100 py-2" href="@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })">Sign in to request a rental</a>
                        }
                        <a id="d-rent-form" class="btn btn-brand w-100 py-2 @(Model.IsAvailable ? "" : "disabled")" href="@(Model.IsAvailable ? Url.Action("RequestToRent", "BrowseItems", new { id = Model.ItemId }) : "#")" aria-disabled="@(!Model.IsAvailable)">Request to Rent <i class="bi bi-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>

            <!-- Lender -->
            <div class="d-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0"><i class="bi bi-person"></i>Lender Profile</h3>
                    <span class="tag blue"><i class="bi bi-shield-check me-1"></i>Verified QCU Student</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="lender-av">@Model.Lender.Initials</div>
                    <div class="flex-grow-1">
                        <div class="fw-bold">@Model.Lender.Name</div>
                        <div class="small text-secondary">@Model.Lender.College &middot; @Model.Lender.Program</div>
                    </div>
                    <button type="button" id="d-msg" class="btn btn-link btn-sm text-decoration-none fw-semibold"><i class="bi bi-chat-left-text me-1"></i>Message</button>
                </div>
                <div class="d-flex flex-wrap gap-3 small mt-3 pt-3 border-top">
                    <span><i class="bi bi-star-fill" style="color:#f5a524"></i> <strong>@Model.Lender.Rating.ToString("0.0")</strong> (@Model.Lender.ReviewCount reviews)</span>
                    <span class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>@Model.Lender.OnTimeRate on-time handover</span>
                    <span class="text-secondary">@Model.Lender.CompletedRentals completed rentals</span>
                </div>
            </div>

            <!-- Description -->
            <div class="d-card">
                <h3><i class="bi bi-file-text"></i>Item Description</h3>
                <p class="small text-secondary mb-0">@Model.Description</p>
            </div>

            <!-- Condition -->
            <div class="d-card">
                <h3><i class="bi bi-patch-check"></i>Condition &amp; Verification</h3>
                <div class="verify-box">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <strong>Physical State: @Model.Condition (@(Model.ConditionScore.ToString("0.0"))/10)</strong>
                        <p class="mb-0 mt-1">@Model.ConditionNotes</p>
                        @foreach (var tag in Model.ConditionTags)
                        {
                            <span class="chip"><i class="bi bi-check2-circle text-primary"></i>@tag</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@Html.Partial("_AvailabilityModal", Model)

@section Scripts {
    <script src="@Url.Content("~/Scripts/availability.js")"></script>
    <script>
        // Gallery thumbnails
        document.querySelectorAll(".gal-thumb").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var img = document.getElementById("g-main");
                img.style.transform = btn.dataset.transform;
                img.style.transformOrigin = btn.dataset.origin;
                document.querySelectorAll(".gal-thumb").forEach(function (b) { b.classList.toggle("active", b === btn); });
            });
        });

        // Message lender (placeholder until chat exists)
        var msg = document.getElementById("d-msg");
        if (msg) msg.addEventListener("click", function () {
            UniShareAvail.toast("Opening chat with @Model.Lender.Name...");
        });
    </script>
}
