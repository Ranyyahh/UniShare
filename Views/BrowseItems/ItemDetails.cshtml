@model UniShare.Models.ItemDetailsViewModel
@using System.Linq
@{
    ViewBag.Title = Model.Name;
    var first = Model.Gallery.FirstOrDefault();
}

@section Styles {
    <!-- If your _Layout already loads Bootstrap 5 + Bootstrap Icons, remove those two links. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/items.css")" rel="stylesheet">
}

<main class="browse-container container-xxl">

    <div class="mb-3">
        <a class="btn btn-outline-soft d-inline-flex align-items-center gap-2" href="@Url.Action("Index", "BrowseItems")" aria-label="Back to Browse Items"><i class="bi bi-arrow-left" aria-hidden="true"></i><span>Back to Browse Items</span></a>
    </div>

    <div class="row g-4">

        <!-- LEFT: gallery and owner profile -->
        <div class="col-lg-6">
            <div class="d-card">
                <div class="gal-main" id="galleryMain" role="button" tabindex="0" aria-label="Open full size item photo">
                    @if (first != null) { <img id="g-main" src="@first.ImageUrl" alt="@Model.Name" style="transform:@first.Transform;transform-origin:@first.TransformOrigin"> }
                    else { <div class="item-photo-empty" role="img" aria-label="No photo uploaded"><i class="bi bi-camera"></i><span>No photo uploaded</span></div> }
                    <span class="gal-badge tl"><i class="bi bi-patch-check me-1"></i>Actual Item Condition</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Campus)) { <span class="gal-badge br"><i class="bi bi-geo-alt me-1 text-primary"></i>@Model.Campus Campus</span> }
                </div>

                <div class="gal-thumbs">
                    @for (var g = 0; g < Model.Gallery.Count; g++)
                    {
                        var th = Model.Gallery[g];
                        var thumbClass = g == 0 ? "gal-thumb active" : "gal-thumb";
                        <button type="button" class="@thumbClass" data-transform="@th.Transform" data-origin="@th.TransformOrigin">
                            <img src="@th.ImageUrl" alt="@th.Label" style="transform:@th.Transform;transform-origin:@th.TransformOrigin">
                            <span>@th.Label</span>
                        </button>
                    }
                </div>
            </div>

            <div class="d-card lender-profile-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0"><i class="bi bi-person"></i>Owner Profile</h3>
                    @if (Model.Lender.IsVerified) { <span class="tag blue"><i class="bi bi-shield-check me-1"></i>Verified student</span> }
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="lender-av">@Model.Lender.Initials</div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-bold">@Model.Lender.Name</div>
                        <div class="small text-secondary">@string.Join(" · ", new[] { Model.Lender.College, Model.Lender.Program }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                        <div class="small mt-1">
                            @if (Model.Lender.Rating.HasValue) { <span><i class="bi bi-star-fill" style="color:#f5a524"></i> <strong>@Model.Lender.Rating.Value.ToString("0.0")</strong> (@Model.Lender.ReviewCount reviews)</span> }
                            else { <span class="text-secondary">No owner ratings yet</span> }
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
                    <a class="btn btn-outline-soft btn-sm" href="@Url.Action("OwnerProfile", "BrowseItems", new { id = Model.OwnerId })">View profile</a>
                    <a id="d-msg" class="btn btn-outline-soft btn-sm" href="@Url.Action("Index", "Messages", new { userId = Model.OwnerId, itemId = Model.ItemId })"><i class="bi bi-chat-left-text me-1"></i>Message Owner</a>
                    <span class="small text-secondary align-self-center ms-auto">@Model.Lender.CompletedRentals completed rentals</span>
                </div>
            </div>
        </div>

        <!-- RIGHT: details -->
        <div class="col-lg-6">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="tag blue">@Model.CategoryLabel</span>
                <span class="tag green">
                    <i class="bi bi-circle-fill me-1" style="font-size:.4rem;vertical-align:middle"></i>@(Model.IsAvailable ? "Available Now" : "Currently Rented")
                </span>
                <span class="tag">@Model.Condition</span>
                @if (!string.IsNullOrWhiteSpace(Model.ListedText)) { <span class="ms-auto small text-secondary">Listed @Model.ListedText</span> }
            </div>

            <h1 class="d-title mb-2">@Model.Title</h1>

            <!-- Rate card -->
            <div class="d-card rate-card">
                <div class="rate-label">CAMPUS RENTAL RATE</div>
                <div class="d-flex justify-content-between align-items-end">
                    <div><span class="rate-price">₱@Model.HourlyRate.ToString("0.##")</span> <span class="text-secondary">/ hr</span></div>
                    <span class="state-badge">Daily rate ₱@Model.DailyRate.ToString("0.##")</span>
                </div>
                <div class="small my-3">
                    @if (!string.IsNullOrWhiteSpace(Model.AvailableHours))
                    {
                        <i class="bi bi-circle-fill text-success me-2" style="font-size:.45rem;vertical-align:middle"></i><i class="bi bi-clock text-success me-2"></i><text>Handover window: </text><strong>@Model.AvailableHours</strong>
                    }
                </div>
                <div class="row g-2">
                    <div class="col-12">
                        @if (ViewBag.IsStudentVerified == true)
                        {
                            <a id="d-rent-form" class="btn btn-brand w-100 py-2 @(Model.IsAvailable ? "" : "disabled")" href="@(Model.IsAvailable ? Url.Action("RequestToRent", "BrowseItems", new { id = Model.ItemId }) : "#")" aria-disabled="@(!Model.IsAvailable)">Request to Rent <i class="bi bi-arrow-right ms-1"></i></a>
                        }
                        else if (ViewBag.IsAuthenticated == true)
                        {
                            <a class="btn btn-outline-soft w-100 py-2" href="@Url.Action("Status", "Verification")">Verify your student account to rent</a>
                        }
                        else
                        {
                        <a id="d-rent-form" class="btn btn-outline-soft w-100 py-2" href="@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })">Sign in to request a rental</a>
                        }
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="d-card description-card">
                <h3><i class="bi bi-file-text"></i>Item Description</h3>
                <p class="small text-secondary mb-0 item-description-text">@Model.Description</p>
                @if (!string.IsNullOrWhiteSpace(Model.Accessories))
                {
                    <p class="small mt-3 mb-0"><strong>Included accessories:</strong> @Model.Accessories</p>
                }
                @if (Model.ReplacementValue > 0)
                {
                    <p class="small mt-2 mb-0"><strong>Declared replacement value:</strong> ₱@Model.ReplacementValue.ToString("N2")</p>
                }
            </div>

            <!-- Condition -->
            <div class="d-card">
                <h3><i class="bi bi-patch-check"></i>Condition &amp; Verification</h3>
                <div class="verify-box">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <strong>Physical condition: @Model.Condition</strong>
                        <p class="mb-0 mt-1">@Model.ConditionNotes</p>
                        @foreach (var tag in Model.ConditionTags)
                        {
                            <span class="chip"><i class="bi bi-check2-circle text-primary"></i>@tag</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="photo-viewer" id="photoViewer" role="dialog" aria-modal="true" aria-label="Full size item photo" hidden>
        <div class="photo-viewer__dialog" id="photoViewerDialog">
            <button type="button" class="photo-viewer__close" id="photoViewerClose" aria-label="Close photo viewer">&times;</button>
            <button type="button" class="photo-viewer__nav photo-viewer__nav--previous" id="photoViewerPrevious" aria-label="View previous photo"><span aria-hidden="true">&#8249;</span></button>
            <img class="photo-viewer__image" id="photoViewerImage" alt="Full size @Model.Name photo" />
            <button type="button" class="photo-viewer__nav photo-viewer__nav--next" id="photoViewerNext" aria-label="View next photo"><span aria-hidden="true">&#8250;</span></button>
            <div class="photo-viewer__counter" id="photoViewerCounter" aria-live="polite"></div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Gallery thumbnails
        var galleryMain = document.getElementById("galleryMain");
        var photoViewer = document.getElementById("photoViewer");
        var photoViewerImage = document.getElementById("photoViewerImage");
        var photoViewerClose = document.getElementById("photoViewerClose");
        var photoViewerPrevious = document.getElementById("photoViewerPrevious");
        var photoViewerNext = document.getElementById("photoViewerNext");
        var photoViewerCounter = document.getElementById("photoViewerCounter");
        var photoViewerReturnFocus = null;
        var galleryButtons = Array.prototype.slice.call(document.querySelectorAll(".gal-thumb"));
        var activeGalleryIndex = 0;
        var photoChangeTimer = null;

        function selectGalleryImage(index, direction) {
            var mainImage = document.getElementById("g-main");
            if (!galleryButtons.length || !mainImage) return;
            activeGalleryIndex = (index + galleryButtons.length) % galleryButtons.length;
            var button = galleryButtons[activeGalleryIndex];
            var thumbnail = button.querySelector("img");
            if (!thumbnail) return;
            mainImage.src = thumbnail.src;
            mainImage.alt = thumbnail.alt;
            mainImage.style.transform = button.dataset.transform || "";
            mainImage.style.transformOrigin = button.dataset.origin || "";
            galleryButtons.forEach(function (item, itemIndex) { item.classList.toggle("active", itemIndex === activeGalleryIndex); });
            if (photoViewer && !photoViewer.hidden) {
                photoViewerImage.src = mainImage.src;
                photoViewerImage.alt = "Full size " + mainImage.alt;
                photoViewerImage.style.transform = "none";
                photoViewerImage.style.transformOrigin = "center center";
                photoViewerCounter.textContent = (activeGalleryIndex + 1) + " / " + galleryButtons.length;
                photoViewerImage.classList.remove("is-changing-next", "is-changing-previous");
                void photoViewerImage.offsetWidth;
                photoViewerImage.classList.add(direction === "previous" ? "is-changing-previous" : "is-changing-next");
                window.clearTimeout(photoChangeTimer);
                photoChangeTimer = window.setTimeout(function () { photoViewerImage.classList.remove("is-changing-next", "is-changing-previous"); }, 220);
            }
        }

        function openPhotoViewer() {
            var image = document.getElementById("g-main");
            if (!image || !photoViewer) return;
            var activeButtonIndex = galleryButtons.findIndex(function (button) { return button.classList.contains("active"); });
            if (activeButtonIndex >= 0) activeGalleryIndex = activeButtonIndex;
            photoViewerImage.src = image.src;
            photoViewerImage.alt = image.alt;
            photoViewerImage.style.transform = "none";
            photoViewerImage.style.transformOrigin = "center center";
            var hasMultiplePhotos = galleryButtons.length > 1;
            photoViewerPrevious.hidden = !hasMultiplePhotos;
            photoViewerNext.hidden = !hasMultiplePhotos;
            photoViewerCounter.hidden = !hasMultiplePhotos;
            photoViewerCounter.textContent = hasMultiplePhotos ? (activeGalleryIndex + 1) + " / " + galleryButtons.length : "";
            photoViewerReturnFocus = document.activeElement;
            photoViewer.hidden = false;
            document.body.classList.add("photo-viewer-open");
            photoViewerClose.focus();
        }
        function showPreviousPhoto() { selectGalleryImage(activeGalleryIndex - 1, "previous"); }
        function showNextPhoto() { selectGalleryImage(activeGalleryIndex + 1, "next"); }
        function closePhotoViewer() {
            if (!photoViewer || photoViewer.hidden) return;
            photoViewer.hidden = true;
            document.body.classList.remove("photo-viewer-open");
            if (photoViewerReturnFocus && photoViewerReturnFocus.focus) photoViewerReturnFocus.focus();
        }
        if (galleryMain) {
            galleryMain.addEventListener("click", openPhotoViewer);
            galleryMain.addEventListener("keydown", function (event) {
                if (event.key === "Enter" || event.key === " ") { event.preventDefault(); openPhotoViewer(); }
            });
        }
        if (photoViewerClose) photoViewerClose.addEventListener("click", closePhotoViewer);
        if (photoViewerPrevious) photoViewerPrevious.addEventListener("click", showPreviousPhoto);
        if (photoViewerNext) photoViewerNext.addEventListener("click", showNextPhoto);
        if (photoViewer) photoViewer.addEventListener("click", function (event) { if (event.target === photoViewer) closePhotoViewer(); });
        document.addEventListener("keydown", function (event) {
            if (!photoViewer || photoViewer.hidden) return;
            if (event.key === "Escape") closePhotoViewer();
            else if (event.key === "ArrowLeft" && galleryButtons.length > 1) { event.preventDefault(); showPreviousPhoto(); }
            else if (event.key === "ArrowRight" && galleryButtons.length > 1) { event.preventDefault(); showNextPhoto(); }
        });

        galleryButtons.forEach(function (btn, index) {
            btn.addEventListener("click", function () { selectGalleryImage(index); });
        });

    </script>
}
