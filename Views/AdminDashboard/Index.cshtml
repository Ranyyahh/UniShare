@model UniShare.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Dashboard";
    ViewBag.ShowAdminSidebar = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles { <link rel="stylesheet" href="@Url.Content("~/Content/admin-accountability.css")" /> }

<main class="aa-page">
    <header class="aa-page-head">
        <div><p class="aa-eyebrow">ADMIN WORKSPACE</p><h1>Platform activity</h1><p>Review rentals, incoming reports, account actions, and recent administrator activity.</p></div>
    </header>
    @if (ViewBag.DatabaseUnavailable == true) { <div class="aa-alert aa-alert--error">Dashboard data is unavailable. Check the database connection.</div> }
    <section class="aa-stats" aria-label="Platform summary">
        <article class="aa-stat"><span>Registered users</span><strong>@Model.RegisteredUsers</strong><a href="@Url.Action("Index", "UserManagement")">Open directory →</a></article>
        <article class="aa-stat"><span>Active bookings</span><strong>@Model.ActiveBookings</strong><a href="@Url.Action("Index", "AdminItemBooking")">Monitor bookings →</a></article>
        <article class="aa-stat aa-stat--warn"><span>Open disputes</span><strong>@Model.OpenDisputes</strong><a href="@Url.Action("Index", "DisputeManagement")">Review disputes →</a></article>
        <article class="aa-stat aa-stat--warn"><span>Pending no-show reports</span><strong>@Model.PendingNoShowReports</strong><a href="@Url.Action("Index", "NoShowReports")">Review reports →</a></article>
        <article class="aa-stat"><span>Reported reviews</span><strong>@Model.ReportedReviews</strong><a href="@Url.Action("Index", "RatingsReviews", new { filter = "reported" })">Moderate reviews →</a></article>
        <article class="aa-stat aa-stat--danger"><span>Active restrictions</span><strong>@Model.ActiveRestrictions</strong><a href="@Url.Action("Index", "AccountRestriction")">Manage restrictions →</a></article>
    </section>
    <section class="aa-panel">
        <div class="aa-panel__head"><div><h2>Recent activity</h2><p>Recorded reports, reviews, and administrator decisions.</p></div><a class="aa-button aa-button--quiet" href="@Url.Action("Index", "AuditLogs")">Open audit log</a></div>
        @if (Model.RecentActivity == null || Model.RecentActivity.Count == 0) { <p class="aa-empty">No activity has been recorded yet.</p> }
        else
        {
            <div class="aa-table-wrap"><table class="aa-table"><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Record</th><th>Details</th></tr></thead><tbody>
            @foreach (var row in Model.RecentActivity) { <tr><td>@row.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td><td>@row.ActorName</td><td>@row.Action.Replace('_', ' ')</td><td>@row.EntityType @row.EntityId</td><td class="aa-wrap">@row.Summary</td></tr> }
            </tbody></table></div>
        }
    </section>
</main>
