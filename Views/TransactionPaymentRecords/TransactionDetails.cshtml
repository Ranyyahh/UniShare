@model UniShare.Models.TransactionViewModel
@{
    Layout = null;
    var statusLabel = Model.Status == "UNPAID" && !string.IsNullOrWhiteSpace(Model.SubmittedAt) ? "Awaiting Owner Confirmation" : Model.Status;
    var statusBadgeClass = Model.Status == "PAID" ? "badge-confirmed" : Model.Status == "UNPAID" ? "badge-pending" : "badge-pending";
}

<div class="modal-form-wrapper" id="payment-admin-details">
    <div class="modal-header-bar">
        <div class="modal-title-group">
            <h3 class="modal-txn-id">Payment @Model.TransactionId</h3>
            <span class="badge badge-live-record"><span class="live-dot"></span> DATABASE RECORD</span>
            <span class="badge @statusBadgeClass" id="modalStatusBadge">@statusLabel</span>
        </div>
        <button type="button" id="btnTxnCloseModal" class="btn-close-modal" title="Close Modal">&times;</button>
    </div>

    <div class="modal-body-scroll">
        <div class="modal-section">
            <label class="form-section-title">Rental and payment</label>
            <div class="modal-item-row">
                <div class="img-placeholder"><i class="glyphicon glyphicon-list-alt"></i></div>
                <div class="modal-item-text">
                    <div class="modal-item-name">@Model.ItemName</div>
                    <div class="modal-item-sub"><span>Request: <strong class="txn-code">@Model.BookingId</strong></span><span class="modal-meta-sep">&bull;</span><span>Charge: <strong>@Model.ChargeType.Replace("_", " ")</strong></span></div>
                </div>
            </div>
        </div>

        <div class="modal-section">
            <label class="form-section-title">Parties</label>
            <div class="modal-two-col">
                <div class="party-card party-card-borrower"><div class="party-role-tag role-borrower">Borrower</div><div class="party-name">@Model.BorrowerName</div><div class="party-sub"><span class="party-label">Student ID:</span> <span class="txn-code">@Model.BorrowerId</span></div><div class="party-sub"><span class="party-label">Program:</span> @Model.BorrowerCourse</div></div>
                <div class="party-card party-card-owner"><div class="party-role-tag role-owner">Owner</div><div class="party-name">@Model.OwnerName</div><div class="party-sub"><span class="party-label">Student ID:</span> <span class="txn-code">@Model.OwnerId</span></div><div class="party-sub"><span class="party-label">Program:</span> @Model.OwnerCourse</div></div>
            </div>
        </div>

        <div class="settlement-box">
            <div class="settlement-title">RECORDED PAYMENT BREAKDOWN</div>
            <div class="settlement-row"><span>Rental fee</span><span class="currency">@Model.BaseFee</span></div>
            <div class="settlement-row penalty-text"><span>Late fee</span><span>@Model.LateFee</span></div>
            <div class="settlement-row"><span>Payment method</span><span>@Model.Method</span></div>
            <div class="settlement-row total-row"><span>Payment amount</span><span class="currency">@Model.TotalAmount</span></div>
            @if (!string.IsNullOrWhiteSpace(Model.GCashRef))
            {
                <div class="gcash-box"><span>GCash reference: <strong id="modalGcashRefText">@Model.GCashRef</strong></span><button type="button" class="btn-copy-ref" id="btnCopyGcashRef" title="Copy reference number"><i class="glyphicon glyphicon-copy"></i> Copy</button></div>
            }
        </div>

        <div class="modal-section">
            <label class="form-section-title">Payment timeline</label>
            <div class="audit-timeline">
                <div class="timeline-step"><span class="timeline-icon icon-blue"><i class="glyphicon glyphicon-time"></i></span><div class="timeline-content"><div class="timeline-title">Payment record created</div><div class="timeline-meta">@Model.DateLogged</div></div></div>
                @if (!string.IsNullOrWhiteSpace(Model.SubmittedAt))
                {
                    <div class="timeline-step"><span class="timeline-icon icon-blue"><i class="glyphicon glyphicon-send"></i></span><div class="timeline-content"><div class="timeline-title">Borrower reported payment</div><div class="timeline-meta">@Model.SubmittedAt</div></div></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.OwnerConfirmedAt))
                {
                    <div class="timeline-step"><span class="timeline-icon icon-emerald"><i class="glyphicon glyphicon-ok-sign"></i></span><div class="timeline-content"><div class="timeline-title">Owner confirmed receipt</div><div class="timeline-meta">@Model.OwnerConfirmedAt</div></div></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.DisputeReason))
                {
                    <div class="timeline-step"><span class="timeline-icon icon-amber"><i class="glyphicon glyphicon-warning-sign"></i></span><div class="timeline-content"><div class="timeline-title">Payment disputed</div><div class="timeline-meta">@Model.DisputeReason</div></div></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.RefundedAt))
                {
                    <div class="timeline-step"><span class="timeline-icon icon-amber"><i class="glyphicon glyphicon-repeat"></i></span><div class="timeline-content"><div class="timeline-title">Payment refunded</div><div class="timeline-meta">@Model.RefundedAt</div></div></div>
                }
            </div>
        </div>
        <div id="modalAlertBox" class="modal-alert-box" style="display:none;"></div>
    </div>

    <div class="modal-actions-bar">
        @if (Model.Status == "PAID" || Model.Status == "DISPUTED")
        {
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-send-reminder" id="btnRefundPayment" data-payment-id="@Model.TransactionId" data-url="@Url.Action("RefundPayment", "Payments")">Record refund</button>
        }
        <button type="button" class="btn btn-default" id="btnTxnFooterClose">Close</button>
    </div>
</div>
