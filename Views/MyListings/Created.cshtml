@model UniShare.Models.ListingCreatedViewModel
@{
    ViewBag.Title = "Listing Submitted";
}

@* ===== Page-scoped assets (loaded only on this page) ===== *@
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: { sans: ['Inter', 'sans-serif'] },
                colors: { brand: { 50: '#eef2ff', 100: '#e0e7ff', DEFAULT: '#3525cd', 700: '#2a1da6' } }
            }
        }
    };
</script>

<div class="font-sans bg-[#f8f9fc] text-slate-800 antialiased min-h-screen px-4 sm:px-6 lg:px-8 py-10">
<main class="max-w-[760px] mx-auto">
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm px-6 sm:px-8 py-8">

        @* ===== Headline ===== *@
        <div class="text-center">
            <div class="mx-auto w-16 h-16 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center">
                <i data-lucide="circle-check" class="w-8 h-8"></i>
            </div>
            <h1 class="mt-6 text-3xl sm:text-4xl font-bold tracking-tight text-slate-800">Listing Submitted for Review</h1>
            <p class="mt-3 text-slate-600 leading-relaxed max-w-xl mx-auto">
                Your <strong class="font-semibold text-slate-900">@Model.ItemName</strong> is saved and waiting for admin approval. It will not appear in Browse Items until it is approved.
            </p>

            <div class="mt-5 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-full border border-indigo-100 bg-indigo-50/60 px-4 py-1.5 text-xs">
                <span class="inline-flex items-center gap-1.5 font-semibold text-slate-700">
                    <i data-lucide="hash" class="w-3.5 h-3.5 text-brand"></i>Listing ID: @Model.ListingCode
                </span>
                    <span class="inline-flex items-center gap-1.5 font-medium text-amber-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Pending approval
                </span>
            </div>
        </div>

        @* ===== Listing summary card ===== *@
        <div class="mt-8 rounded-xl border border-indigo-100 bg-indigo-50/40 p-5 flex flex-col sm:flex-row gap-5">
            <div class="relative shrink-0 w-full sm:w-28 h-40 sm:h-28 rounded-lg overflow-hidden bg-slate-100">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Url.Content(Model.ImageUrl)" alt="@Model.ItemName" class="w-full h-full object-cover" /> }
                else { <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-500"><i data-lucide="camera" class="w-6 h-6"></i></div> }
                <span class="absolute top-2 left-2 bg-slate-900/85 text-white text-[10px] font-semibold px-2 py-0.5 rounded">@Model.Condition</span>
            </div>

            <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2">
                            <span class="bg-indigo-100 text-brand text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded">@Model.CategoryBadge</span>
                        </div>
                        <h2 class="mt-1.5 text-lg font-semibold text-slate-900 truncate" title="@Model.ItemName">@Model.ItemName</h2>
                    </div>
                    <div class="text-right shrink-0">
                        <p>
                            <span class="text-xl font-bold text-brand">&#8369;@Model.Price.ToString("0.##")</span>
                            <span class="text-xs text-slate-500">/ @Model.PerHours hrs</span>
                        </p>
                        @if (Model.WholeDayPrice.HasValue)
                        {
                            <p class="text-[11px] text-slate-600">&#8369;@Model.WholeDayPrice.Value.ToString("0.##") whole day bundle</p>
                        }
                    </div>
                </div>

                <div class="mt-3 pt-3 border-t border-slate-200 flex items-center text-sm text-slate-700">
                    <span class="inline-flex items-center gap-2"><i data-lucide="clock" class="w-4 h-4 text-brand"></i>@Model.AvailabilityText</span>
                </div>
            </div>
        </div>

        @* ===== What happens next ===== *@
        <div class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4 flex items-start gap-3">
                <span class="w-9 h-9 shrink-0 rounded-lg bg-indigo-100 text-brand flex items-center justify-center"><i data-lucide="bell-ring" class="w-4 h-4"></i></span>
                <div>
                    <h3 class="text-sm font-semibold text-slate-900">1. Alerts On</h3>
                    <p class="mt-1 text-xs text-slate-600 leading-relaxed">After approval, classmates can find this item and send rental requests.</p>
                </div>
            </div>
            <div class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4 flex items-start gap-3">
                <span class="w-9 h-9 shrink-0 rounded-lg bg-sky-100 text-sky-800 flex items-center justify-center"><i data-lucide="shield" class="w-4 h-4"></i></span>
                <div>
                    <h3 class="text-sm font-semibold text-slate-900">2. Safe Handover</h3>
                    <p class="mt-1 text-xs text-slate-600 leading-relaxed">Share the handover location saved with your listing and agree on pickup details with the borrower.</p>
                </div>
            </div>
            <div class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4 flex items-start gap-3">
                <span class="w-9 h-9 shrink-0 rounded-lg bg-orange-100 text-orange-700 flex items-center justify-center"><i data-lucide="sliders-horizontal" class="w-4 h-4"></i></span>
                <div>
                    <h3 class="text-sm font-semibold text-slate-900">3. Manage Anytime</h3>
                    <p class="mt-1 text-xs text-slate-600 leading-relaxed">You can follow review status or update your listing from My Listings.</p>
                </div>
            </div>
        </div>

        @* ===== Actions ===== *@
        <div class="mt-8 flex flex-col items-center gap-4">
            <div class="flex flex-col sm:flex-row items-center gap-3">
                <a href="@Url.Action("ItemListings", "MyListings")"
                   class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand text-white text-sm font-semibold shadow-md shadow-indigo-900/20 hover:bg-brand-700 transition active:scale-[0.98]">
                    <i data-lucide="list" class="w-4 h-4"></i>View My Listings<i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
                <a href="@Url.Action("Edit", "MyListings", new { id = Model.Id })"
                   class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-slate-300 bg-white text-sm font-semibold text-slate-800 hover:bg-slate-50 transition">
                    <i data-lucide="pencil" class="w-4 h-4 text-slate-600"></i>Edit This Listing
                </a>
            </div>
            <a href="@Url.Action("Create", "MyListings")" class="inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline">
                <i data-lucide="circle-plus" class="w-4 h-4"></i>Create Another Listing
            </a>
        </div>
    </section>
</main>
</div>

<script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
<script>lucide.createIcons();</script>
