@model UniShare.Models.ListingsPageViewModel
@using UniShare.Models
@{
    ViewBag.Title = "My Listings";
}
<link rel="stylesheet" href="@Url.Content("~/Content/MyListings.css")" />

<main class="my-listings-page">
    <header class="my-listings-header">
        <div>
            
            <h1>My Listings</h1>
            <p>Manage your items and track their approval status.</p>
        </div>
        <a class="my-listings-create" href="@Url.Action("Create", "MyListings")"><span aria-hidden="true">+</span><span>Create Listing</span></a>
    </header>

    @if (TempData["Message"] != null || TempData["Error"] != null)
    {
        var hasError = TempData["Error"] != null;
        <div class="my-listings-alert @(hasError ? "is-error" : "is-success")" role="status">@(hasError ? TempData["Error"] : TempData["Message"])</div>
    }

    <section class="my-listings-summary" aria-label="Listing summary">
        <article class="my-listings-summary-card">
            <span>Total Listings</span><strong>@Model.TotalCount</strong>
        </article>
        <article class="my-listings-summary-card is-pending">
            <span>Pending Listings</span><strong>@Model.PendingListingCount</strong>
        </article>
        <article class="my-listings-summary-card is-rejected">
            <span>Rejected Listings</span><strong>@Model.RejectedListingCount</strong>
        </article>
    </section>

    <section class="my-listings-table-panel" aria-labelledby="myListingsHeading">
        <div class="my-listings-table-heading">
            <div>
                <h2 id="myListingsHeading">Your listings</h2>
                <p>New and updated listings are reviewed before they appear in Browse Items.</p>
            </div>
            <span class="my-listings-count">@Model.TotalCount total</span>
        </div>
        <div class="my-listings-table-scroll">
            <table class="my-listings-table">
                <thead>
                    <tr><th scope="col">Item</th><th scope="col">Category</th><th scope="col">Price</th><th scope="col">Date Submitted</th><th scope="col">Status</th><th scope="col"><span class="my-listings-visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @if (!Model.HasListings)
                    {
                        <tr><td colspan="6" class="my-listings-empty">No listings yet. Create a listing to get started.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Listings)
                        {
                            var approval = (item.ApprovalStatus ?? "PENDING").ToUpperInvariant();
                            var statusClass = approval.ToLowerInvariant();
                            var statusLabel = approval == "APPROVED" ? "Approved" : approval == "REJECTED" ? "Rejected" : "Pending";
                            <tr>
                                <td>
                                    <div class="my-listings-item">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@Url.Content(item.ImageUrl)" alt="" />
                                        }
                                        else
                                        {
                                            <span class="my-listings-image-placeholder" aria-hidden="true"></span>
                                        }
                                        <div><strong>@item.Title</strong>
                                            @if (approval == "REJECTED" && !string.IsNullOrWhiteSpace(item.RejectionReason))
                                            {
                                                <small class="my-listings-reason">Reason: @item.RejectionReason</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@item.CategoryLabel</td>
                                <td class="my-listings-price">&#8369;@((item.Price / Math.Max(1, item.PerHours)).ToString("0")) <small>/hr</small></td>
                                <td>@(item.CreatedAt == default(DateTime) ? "-" : item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy"))</td>
                                <td><span class="my-listings-status is-@statusClass">@statusLabel</span></td>
                                <td>
                                    <div class="my-listings-actions">
                                        <a href="@Url.Action("Details", "MyListings", new { id = item.Id })">View Details</a>
                                        @if (item.Status != ListingStatus.Rented)
                                        {
                                            <a class="is-edit" href="@Url.Action("Edit", "MyListings", new { id = item.Id })">Edit Listing</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
