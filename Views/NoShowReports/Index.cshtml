@model System.Collections.Generic.IList<UniShare.Models.NoShowIncidentViewModel>
@{ ViewBag.Title = "No-Show Reports"; ViewBag.ShowAdminSidebar = true; }
@section Styles { <link rel="stylesheet" href="@Url.Content("~/Content/admin-accountability.css")" /> }
<main class="aa-page">
    <header class="aa-page-head"><div><p class="aa-eyebrow">ADMIN WORKSPACE</p><h1>No-show reports</h1><p>Review reports from the owner or borrower. Confirmed incidents cancel the booking; the first confirmed incident creates a warning for the reported student.</p></div></header>
    @if (TempData["Success"] != null) { <div class="aa-alert">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="aa-alert aa-alert--error">@TempData["Error"]</div> }
    @if (ViewBag.DatabaseUnavailable == true) { <div class="aa-alert aa-alert--error">No-show reports are unavailable. Check the database connection.</div> }
    <section class="aa-panel"><div class="aa-panel__head"><div><h2>Incident queue</h2><p>@Model.Count reports across all statuses</p></div></div>
        <div class="aa-table-wrap"><table class="aa-table"><thead><tr><th>Booking</th><th>Reported by</th><th>Reported student</th><th>Reason</th><th>Status</th><th>Reported</th><th>Admin review</th></tr></thead><tbody>
        @if (Model.Count == 0) { <tr><td colspan="7" class="aa-empty">No no-show reports have been filed.</td></tr> }
        @foreach (var item in Model)
        {
            <tr><td><span class="aa-cell-title">@item.ItemName</span><span class="aa-cell-sub">@item.RequestId</span></td>
                <td>@item.ReporterName<span class="aa-cell-sub">@item.ReporterRole</span></td><td>@item.SubjectName</td>
                <td class="aa-wrap">@item.Reason</td><td><span class="aa-status aa-status--@item.Status.ToLowerInvariant()">@item.Status</span></td>
                <td>@item.ReportedAt.ToString("MMM d, yyyy h:mm tt")</td>
                <td>
                    @if (item.CanReview)
                    {
                        using (Html.BeginForm("Review", "NoShowReports", FormMethod.Post, new { @class = "aa-inline-form" }))
                        {
                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" />
                            <textarea class="aa-textarea" name="notes" maxlength="1000" placeholder="Review note"></textarea>
                            <div class="aa-actions"><button class="aa-button aa-button--success" type="submit" name="confirm" value="true">Confirm &amp; cancel</button><button class="aa-button aa-button--quiet" type="submit" name="confirm" value="false">Decline</button></div>
                        }
                    }
                    else { <span class="aa-cell-sub">@(String.IsNullOrWhiteSpace(item.AdminNotes) ? "Reviewed" : item.AdminNotes)</span> }
                </td>
            </tr>
        }
        </tbody></table></div>
    </section>
</main>
