@model UniShare.Models.OwnerProfileEditViewModel
@{
    ViewBag.Title = "Account Settings";
    var isAdmin = ViewBag.ShowAdminSidebar != null && (bool)ViewBag.ShowAdminSidebar;
}
@if (isAdmin)
{
    @section Styles { <link rel="stylesheet" href="@Url.Content("~/Content/admin-accountability.css")" /> }
}

<main class="@(isAdmin ? "aa-page" : "container py-5")" style="@(isAdmin ? "" : "max-width: 760px")">
    @if (isAdmin)
    {
        <header class="aa-page-head">
            <div>
                <p class="aa-eyebrow">ADMIN WORKSPACE</p>
                <h1>Account Settings</h1>
                <p>Update your administrator profile details.</p>
            </div>
        </header>
    }
    else
    {
        <h1 class="h2">Account Settings</h1>
        <p class="text-secondary">Manage the public details borrowers see on your owner profile.</p>
    }

    @if (TempData["ProfileSaved"] != null)
    {
        <div class="@(isAdmin ? "aa-alert aa-alert--ok" : "alert alert-success")" role="status">@TempData["ProfileSaved"]</div>
    }

    <section class="@(isAdmin ? "aa-card" : "card border-0 shadow-sm p-4 mt-4")">
        @using (Html.BeginForm("Settings", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                @Html.LabelFor(x => x.Program, new { @class = "form-label" })
                @Html.TextBoxFor(x => x.Program, new { @class = "form-control", maxlength = "80", placeholder = "e.g. BSIT" })
                @Html.ValidationMessageFor(x => x.Program, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(x => x.YearLevel, new { @class = "form-label" })
                @Html.TextBoxFor(x => x.YearLevel, new { @class = "form-control", maxlength = "40", placeholder = "e.g. 3rd Year" })
                @Html.ValidationMessageFor(x => x.YearLevel, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(x => x.Campus, new { @class = "form-label" })
                @Html.TextBoxFor(x => x.Campus, new { @class = "form-control", maxlength = "80", placeholder = "e.g. San Bartolome" })
                @Html.ValidationMessageFor(x => x.Campus, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-4">
                @Html.LabelFor(x => x.Bio, new { @class = "form-label" })
                @Html.TextAreaFor(x => x.Bio, 4, 1, new { @class = "form-control", maxlength = "500", placeholder = "A short introduction for other students." })
                @Html.ValidationMessageFor(x => x.Bio, "", new { @class = "text-danger small" })
            </div>
            <button type="submit" class="@(isAdmin ? "aa-btn aa-btn--primary" : "btn btn-primary")">Save profile</button>
        }
    </section>
</main>
