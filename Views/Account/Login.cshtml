@model UniShare.Models.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<main class="auth-card login-card" aria-labelledby="page-title">
    <div class="portal-badge"><span class="status-dot"></span> QCU STUDENT PORTAL</div>
    <div class="brand-lockup"><span class="brand-name">UniShare</span></div>
    <p class="brand-caption">Peer-to-peer campus rental network for verified students &amp; faculty</p>
    
    <div class="form-heading"><h1 id="page-title">Welcome back</h1></div>
    
    @if (Request.QueryString["registered"] == "true")
    {
        <div class="auth-notice" role="status">
            <div>
                <strong>Account created successfully!</strong>
                <small>Sign in below to check your student verification status.</small>
            </div>
        </div>
    }

    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "auth-form login-form" }))
    {
        @Html.AntiForgeryToken()
        if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
        {
            <div class="auth-alert error">
                @ViewData.ModelState[""].Errors.First().ErrorMessage
            </div>
        }

        <div class="field-group">
            <div class="label-row">
                <label for="SchoolEmail">School Email Address</label>
                @Html.ValidationMessageFor(x => x.SchoolEmail, "", new { @class = "field-error" })
            </div>
            <div class="input-wrap">
                @Html.TextBoxFor(x => x.SchoolEmail, new { type = "email", autocomplete = "username", placeholder = "name@unishare.qcu.edu.ph", required = "required" })
            </div>
        </div>

        <div class="field-group">
            <div class="label-row">
                <label for="Password">Password</label>
                @Html.ValidationMessageFor(x => x.Password, "", new { @class = "field-error" })
            </div>
            <div class="input-wrap">
                @Html.PasswordFor(x => x.Password, new { autocomplete = "current-password", placeholder = "Enter your password", required = "required" })
                <button class="visibility-toggle" type="button" aria-label="Show password" data-password-toggle="Password">
                    <svg viewBox="0 0 24 24"><path d="M12 5c-5 0-9.2 3.3-11 7 1.8 3.7 6 7 11 7s9.2-3.3 11-7c-1.8-3.7-6-7-11-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z" /></svg>
                </button>
            </div>
        </div>

        <label class="remember-row">
            @Html.CheckBoxFor(x => x.RememberMe) Remember me on this device
        </label>

        <button class="primary-button" type="submit">Sign In</button>

        <div class="form-footer">
            <span>New to UniShare? <a class="text-link" href="@Url.Action("Register", "Account")">Create an account</a></span>
        </div>
    }
</main>

@section pageScripts {
    <script>
        (function () {
            document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
                button.addEventListener('click', function () {
                    var targetId = this.getAttribute('data-password-toggle');
                    var input = document.getElementById(targetId);
                    if (input) {
                        var isPassword = input.getAttribute('type') === 'password';
                        input.setAttribute('type', isPassword ? 'text' : 'password');
                    }
                });
            });
        })();
    </script>
}
